---
export interface Props {
  title: string;
  summary: string;
  image: string;
  imageAlt: string;
  highlights?: string[];
  eyebrow?: string;
  disclaimer?: string;
}
const {
  title,
  summary,
  image,
  imageAlt,
  highlights = [],
  eyebrow = 'Caso em destaque',
  disclaimer = 'Registros cedidos pelo aluno. Luz, distância, enquadramento e pose podem variar.',
} = Astro.props;
---

<section id="resultados" class="bg-zinc-100 px-5 py-[var(--space-section)] sm:px-8 lg:px-12">
  <div class="editorial-container">
    <div class="grid gap-12 lg:grid-cols-[.78fr_1.22fr] lg:items-start lg:gap-20">
      <div>
        <p class="eyebrow">04 / {eyebrow}</p>
        <h2 class="display-title mt-5 text-4xl font-semibold leading-[.95] text-zinc-950 sm:text-6xl">
          {title}
        </h2>
        <div class="mt-8 space-y-4 text-base leading-8 text-zinc-600 sm:text-lg">
          {summary.split('\n\n').map((paragraph) => (
            <p>{paragraph}</p>
          ))}
        </div>
        {highlights.length > 0 && (
          <ul class="mt-9 grid gap-3 border-t border-zinc-300 pt-6 sm:grid-cols-2">
            {highlights.map((highlight) => (
              <li class="flex gap-3 text-sm text-zinc-700">
                <span class="mt-1 size-2 shrink-0 rounded-full bg-blue-600"></span>
                {highlight}
              </li>
            ))}
          </ul>
        )}
      </div>
      <figure class="overflow-hidden bg-zinc-950 p-2 sm:p-3">
        <img src={image} alt={imageAlt} loading="lazy" class="w-full rounded-2xl object-cover" />
        <figcaption class="px-2 pb-2 pt-3 text-xs leading-5 text-zinc-400">{disclaimer}</figcaption>
      </figure>
    </div>
  </div>
</section>
