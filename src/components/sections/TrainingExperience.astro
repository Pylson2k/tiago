---
import { ArrowUpRight, Dumbbell, ShieldCheck, SlidersHorizontal, Target } from 'lucide-astro';

export interface Props {
  whatsappHref: string;
}

const { whatsappHref } = Astro.props;

const workout = [
  {
    icon: Dumbbell,
    order: '01',
    target: 'peito',
    title: 'Supino com halteres',
    detail: 'Controle de amplitude e trajetória antes de progredir a carga.',
  },
  {
    icon: Target,
    order: '02',
    target: 'costas',
    title: 'Remada apoiada',
    detail: 'Base estável para concentrar o esforço na puxada e na execução.',
  },
  {
    icon: SlidersHorizontal,
    order: '03',
    target: 'pernas',
    title: 'Agachamento guiado',
    detail: 'Ajuste de posição, profundidade confortável e ritmo consistente.',
  },
  {
    icon: ShieldCheck,
    order: '04',
    target: 'core',
    title: 'Core e estabilidade',
    detail: 'Finalização focada em controle do tronco e qualidade do movimento.',
  },
];
---

<section id="treino-da-semana" class="bg-zinc-950 px-5 py-20 text-white sm:px-8 lg:px-12 lg:py-28">
  <div class="mx-auto max-w-7xl">
    <div class="grid gap-14 lg:grid-cols-[.86fr_1.14fr] lg:items-start lg:gap-20">
      <div>
        <p class="text-xs font-semibold uppercase tracking-[.2em] text-blue-300">
          Treino da semana
        </p>
        <h2 class="mt-4 text-4xl font-semibold tracking-[-.05em] sm:text-5xl">
          Um exemplo de treino pensado como processo
        </h2>
        <p class="mt-6 max-w-xl text-lg leading-8 text-zinc-400">
          A seleção de exercícios é apenas o começo. Amplitude, ritmo, estabilidade e progressão são
          ajustados ao momento de cada aluno.
        </p>

        <ul class="mt-10 grid gap-3 sm:grid-cols-2 lg:grid-cols-1">
          {workout.map(({ icon: Icon, order, target, title, detail }, index) => (
            <li>
              <button
                type="button"
                class:list={[
                  'workout-card group grid w-full grid-cols-[auto_1fr] gap-4 rounded-2xl border p-5 text-left transition hover:border-blue-400/50 hover:bg-white/[.06] focus:outline-none focus:ring-2 focus:ring-blue-400',
                  index === 0
                    ? 'border-blue-400/60 bg-blue-500/[.09]'
                    : 'border-white/10 bg-white/[.035]',
                ]}
                data-workout-target={target}
                aria-pressed={index === 0 ? 'true' : 'false'}
                aria-label={`Mostrar músculos trabalhados em ${title}`}
              >
                <span class="workout-icon flex size-11 items-center justify-center rounded-xl bg-blue-500/15 text-blue-300 transition">
                  <Icon size={20} strokeWidth={1.8} aria-hidden="true" />
                </span>
                <span>
                  <span class="flex items-center justify-between gap-4">
                    <strong class="font-semibold text-zinc-100">{title}</strong>
                    <span class="font-mono text-xs text-zinc-600">{order}</span>
                  </span>
                  <span class="mt-2 block text-sm leading-6 text-zinc-400">{detail}</span>
                </span>
              </button>
            </li>
          ))}
        </ul>

        <p class="mt-6 text-xs leading-6 text-zinc-500">
          Exemplo educativo. A prescrição final depende de avaliação, experiência, objetivo e
          resposta individual.
        </p>
      </div>

      <div
        id="biomecanica"
        class="rounded-[2rem] border border-white/10 bg-zinc-900/70 p-5 shadow-2xl shadow-blue-950/20 sm:p-8"
      >
        <div class="flex flex-col gap-5 border-b border-white/10 pb-6 sm:flex-row sm:items-end sm:justify-between">
          <div>
            <p class="text-xs font-semibold uppercase tracking-[.2em] text-blue-300">
              Biomecânica visual
            </p>
            <h3 class="mt-3 text-2xl font-semibold tracking-tight sm:text-3xl">
              Explore o foco do movimento
            </h3>
          </div>
          <div
            class="inline-flex w-fit rounded-full border border-white/10 bg-zinc-950 p-1"
            role="group"
            aria-label="Vista anatômica"
          >
            <button
              type="button"
              class="anatomy-view min-h-11 rounded-full bg-white px-4 py-2 text-xs font-semibold text-zinc-950"
              data-view="FRONT"
              aria-pressed="true"
            >
              Frente
            </button>
            <button
              type="button"
              class="anatomy-view min-h-11 rounded-full px-4 py-2 text-xs font-semibold text-zinc-400"
              data-view="BACK"
              aria-pressed="false"
            >
              Costas
            </button>
          </div>
        </div>

        <div class="mt-6 flex flex-wrap gap-2" role="group" aria-label="Grupos musculares">
          <button
            type="button"
            aria-pressed="true"
            class="anatomy-tab min-h-11 rounded-full bg-blue-600 px-4 py-2 text-xs font-semibold text-white"
            data-target="peito"
          >
            Peito
          </button>
          <button
            type="button"
            aria-pressed="false"
            class="anatomy-tab min-h-11 rounded-full border border-white/10 px-4 py-2 text-xs font-semibold text-zinc-300"
            data-target="costas"
          >
            Costas
          </button>
          <button
            type="button"
            aria-pressed="false"
            class="anatomy-tab min-h-11 rounded-full border border-white/10 px-4 py-2 text-xs font-semibold text-zinc-300"
            data-target="pernas"
          >
            Pernas
          </button>
          <button
            type="button"
            aria-pressed="false"
            class="anatomy-tab min-h-11 rounded-full border border-white/10 px-4 py-2 text-xs font-semibold text-zinc-300"
            data-target="core"
          >
            Core
          </button>
        </div>

        <div class="mt-7 grid gap-8 sm:grid-cols-[minmax(220px,.82fr)_1.18fr] sm:items-center">
          <div
            id="body-muscles-chart"
            class="mx-auto h-[min(360px,65svh)] w-full max-w-[290px] overflow-hidden rounded-2xl sm:h-[min(420px,65svh)]"
            aria-live="polite"
            role="img"
            aria-label="Mapa anatômico com destaque no peitoral e estabilizadores"
          ></div>
          <div>
            <span
              id="anatomy-latin"
              class="inline-flex rounded-full bg-blue-500/10 px-3 py-1 text-[.68rem] font-semibold uppercase tracking-[.13em] text-blue-300"
            >
              Pectoralis major
            </span>
            <h4 id="anatomy-title" class="mt-4 text-2xl font-semibold tracking-tight">
              Peitoral e estabilizadores
            </h4>
            <p id="anatomy-copy" class="mt-4 leading-7 text-zinc-400">
              A posição do tronco, o controle das escápulas e a trajetória dos cotovelos mudam como
              o esforço é distribuído.
            </p>
            <div class="mt-6 rounded-2xl border border-white/10 bg-zinc-950/70 p-5">
              <p class="text-xs font-semibold uppercase tracking-[.15em] text-zinc-500">
                Leitura do treinador
              </p>
              <p id="anatomy-note" class="mt-3 text-sm leading-6 text-zinc-300">
                Primeiro dominar a execução; depois aumentar a exigência.
              </p>
            </div>
            <a
              href={whatsappHref}
              class="mt-6 inline-flex min-h-11 items-center gap-2 text-sm font-semibold text-white underline decoration-blue-500 decoration-2 underline-offset-4"
            >
              Quero um treino para mim <ArrowUpRight size={17} aria-hidden="true" />
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style is:global>
  #body-muscles-chart .body-chart-container {
    height: 100% !important;
    padding: 0 !important;
  }

  #body-muscles-chart .body-chart-svg {
    width: auto !important;
    height: 100% !important;
    max-width: 100% !important;
    max-height: 100% !important;
  }
</style>

<script is:inline src="/vendor/body-muscles/body-muscles.umd.min.js"></script>
<script is:inline>
  (() => {
    const root = document.querySelector('#body-muscles-chart');
    if (!root || !window.BodyMuscles?.BodyChart || root.dataset.ready === 'true') return;
    root.dataset.ready = 'true';

    const groups = {
      peito: {
        view: 'FRONT',
        latin: 'Pectoralis major',
        title: 'Peitoral e estabilizadores',
        copy: 'A posição do tronco, o controle das escápulas e a trajetória dos cotovelos mudam como o esforço é distribuído.',
        note: 'Primeiro dominar a execução; depois aumentar a exigência.',
        front: {
          'chest-upper-left': { intensity: 9, selected: true },
          'chest-upper-right': { intensity: 9, selected: true },
          'chest-lower-left': { intensity: 10, selected: true },
          'chest-lower-right': { intensity: 10, selected: true },
          'shoulder-front-left': { intensity: 5, selected: false },
          'shoulder-front-right': { intensity: 5, selected: false },
        },
        back: {
          'triceps-long-left': { intensity: 7, selected: true },
          'triceps-long-right': { intensity: 7, selected: true },
        },
      },
      costas: {
        view: 'BACK',
        latin: 'Latissimus dorsi',
        title: 'Dorsais e controle escapular',
        copy: 'A direção dos cotovelos e o movimento das escápulas ajudam a organizar puxadas e remadas com mais intenção.',
        note: 'A carga deve permitir que a puxada continue estável do início ao fim.',
        front: {
          'biceps-left': { intensity: 6, selected: false },
          'biceps-right': { intensity: 6, selected: false },
        },
        back: {
          'lats-upper-left': { intensity: 10, selected: true },
          'lats-upper-right': { intensity: 10, selected: true },
          'lats-mid-left': { intensity: 9, selected: true },
          'lats-mid-right': { intensity: 9, selected: true },
          'traps-mid-left': { intensity: 7, selected: false },
          'traps-mid-right': { intensity: 7, selected: false },
        },
      },
      pernas: {
        view: 'FRONT',
        latin: 'Quadriceps & Gluteus',
        title: 'Pernas e quadril',
        copy: 'Base dos pés, alinhamento e amplitude confortável orientam a execução dos movimentos de membros inferiores.',
        note: 'A melhor variação é aquela que respeita mobilidade, controle e objetivo.',
        front: {
          'quads-left': { intensity: 10, selected: true },
          'quads-right': { intensity: 10, selected: true },
          'adductors-left': { intensity: 6, selected: false },
          'adductors-right': { intensity: 6, selected: false },
        },
        back: {
          'gluteus-maximus-left': { intensity: 10, selected: true },
          'gluteus-maximus-right': { intensity: 10, selected: true },
          'hamstrings-medial-left': { intensity: 8, selected: true },
          'hamstrings-medial-right': { intensity: 8, selected: true },
        },
      },
      core: {
        view: 'FRONT',
        latin: 'Rectus abdominis & Obliquus',
        title: 'Core e estabilidade do tronco',
        copy: 'O controle do tronco ajuda a organizar a transferência de força e a manter a execução estável em diferentes exercícios.',
        note: 'Respiração, posição das costelas e controle pélvico devem trabalhar juntos.',
        front: {
          'abs-upper-left': { intensity: 10, selected: true },
          'abs-upper-right': { intensity: 10, selected: true },
          'abs-lower-left': { intensity: 9, selected: true },
          'abs-lower-right': { intensity: 9, selected: true },
          'obliques-left': { intensity: 8, selected: true },
          'obliques-right': { intensity: 8, selected: true },
        },
        back: {
          'lower-back-erectors-left': { intensity: 8, selected: true },
          'lower-back-erectors-right': { intensity: 8, selected: true },
          'lower-back-ql-left': { intensity: 7, selected: false },
          'lower-back-ql-right': { intensity: 7, selected: false },
        },
      },
    };

    const palette = window.BodyMuscles.INTENSITY_COLORS;
    if (palette) {
      Object.assign(palette, {
        0: '#27272a',
        4: '#313884',
        5: '#3943b7',
        6: '#4a53ff',
        7: '#6870ff',
        8: '#8790ff',
        9: '#aeb3ff',
        10: '#ffffff',
      });
    }

    let current = 'peito';
    let view = 'FRONT';
    const stateFor = () => (view === 'BACK' ? groups[current].back : groups[current].front);
    const chart = new window.BodyMuscles.BodyChart(root, {
      view,
      bodyState: stateFor(),
      enableTransitions: true,
      ariaLabel: 'Mapa anatômico interativo dos grupos musculares',
      onMuscleClick: (_id, name) => {
        document.querySelector('#anatomy-note').textContent =
          `${name}: observe como o exercício e a execução distribuem o esforço nessa região.`;
      },
    });

    root.querySelectorAll('[tabindex]').forEach((part) => part.setAttribute('tabindex', '-1'));

    const updateViewButtons = () => {
      document.querySelectorAll('.anatomy-view').forEach((button) => {
        const active = button.dataset.view === view;
        button.setAttribute('aria-pressed', String(active));
        button.classList.toggle('bg-white', active);
        button.classList.toggle('text-zinc-950', active);
        button.classList.toggle('text-zinc-400', !active);
      });
    };

    const updateTabs = () => {
      document.querySelectorAll('.anatomy-tab').forEach((tab) => {
        const active = tab.dataset.target === current;
        tab.setAttribute('aria-pressed', String(active));
        tab.classList.toggle('bg-blue-600', active);
        tab.classList.toggle('text-white', active);
        tab.classList.toggle('border', !active);
        tab.classList.toggle('border-white/10', !active);
        tab.classList.toggle('text-zinc-300', !active);
      });
    };

    const updateWorkoutCards = () => {
      document.querySelectorAll('.workout-card').forEach((card) => {
        const active = card.dataset.workoutTarget === current;
        card.setAttribute('aria-pressed', String(active));
        card.classList.toggle('border-blue-400/60', active);
        card.classList.toggle('bg-blue-500/[.09]', active);
        card.classList.toggle('border-white/10', !active);
        card.classList.toggle('bg-white/[.035]', !active);
      });
    };

    const render = () => {
      const data = groups[current];
      document.querySelector('#anatomy-latin').textContent = data.latin;
      document.querySelector('#anatomy-title').textContent = data.title;
      document.querySelector('#anatomy-copy').textContent = data.copy;
      document.querySelector('#anatomy-note').textContent = data.note;
      root.setAttribute('aria-label', `Mapa anatômico com destaque em ${data.title.toLowerCase()}`);
      chart.update({ view, bodyState: stateFor() });
      updateViewButtons();
      updateTabs();
      updateWorkoutCards();
    };

    const selectGroup = (target) => {
      if (!groups[target]) return;
      current = target;
      view = groups[current].view;
      render();
    };

    document.querySelectorAll('.anatomy-tab').forEach((button) =>
      button.addEventListener('click', () => {
        selectGroup(button.dataset.target);
      }),
    );

    document.querySelectorAll('.workout-card').forEach((button) =>
      button.addEventListener('click', () => {
        selectGroup(button.dataset.workoutTarget);
      }),
    );

    document.querySelectorAll('.anatomy-view').forEach((button) =>
      button.addEventListener('click', () => {
        view = button.dataset.view;
        render();
      }),
    );
  })();
</script>
