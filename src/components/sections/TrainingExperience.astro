---
import { Dumbbell, ShieldCheck, SlidersHorizontal, Target } from 'lucide-astro';

const workout = [
  {
    icon: Dumbbell,
    order: '01',
    target: 'peito',
    title: 'Supino inclinado com barra',
    detail: 'Controle de amplitude e trajetória antes de progredir a carga.',
    video: '/assets/provas/treino/supino-inclinado.mp4',
  },
  {
    icon: Target,
    order: '02',
    target: 'costas',
    title: 'Puxada para costas',
    detail: 'Base estável para concentrar o esforço na puxada e na execução.',
    video: '/assets/provas/treino/puxada-costas.mp4',
  },
  {
    icon: SlidersHorizontal,
    order: '03',
    target: 'pernas',
    title: 'Agachamento hack',
    detail: 'Ajuste de posição, profundidade confortável e ritmo consistente.',
    video: '/assets/provas/treino/agachamento.mp4',
  },
  {
    icon: ShieldCheck,
    order: '04',
    target: 'core',
    title: 'Rosca de bíceps na polia',
    detail: 'Finalização focada em controle do tronco e qualidade do movimento.',
    video: '/assets/provas/treino/biceps.mp4',
  },
];
---

<section id="treino-da-semana" class="bg-zinc-950 px-5 py-20 text-white sm:px-8 lg:px-12 lg:py-28">
  <div class="mx-auto max-w-7xl">
    <div class="grid gap-14 lg:grid-cols-[.86fr_1.14fr] lg:items-start lg:gap-20">
      <div>
        <p class="text-xs font-semibold uppercase tracking-[.2em] text-blue-300">
          Treino da semana
        </p>
        <h2 class="mt-4 text-4xl font-semibold tracking-[-.05em] sm:text-5xl">
          Um exemplo de treino pensado como processo
        </h2>
        <p class="mt-6 max-w-xl text-lg leading-8 text-zinc-400">
          A seleção de exercícios é apenas o começo. Amplitude, ritmo, estabilidade e progressão são
          ajustados ao momento de cada aluno.
        </p>

        <ul class="mt-10 grid gap-3 sm:grid-cols-2 lg:grid-cols-1">
          {workout.map(({ icon: Icon, order, target, title, detail, video }, index) => (
            <li>
              <button
                type="button"
                class:list={[
                  'workout-card group grid w-full grid-cols-[auto_1fr] gap-4 rounded-2xl border p-5 text-left transition hover:border-blue-400/50 hover:bg-white/[.06] focus:outline-none focus:ring-2 focus:ring-blue-400',
                  index === 0
                    ? 'border-blue-400/60 bg-blue-500/[.09]'
                    : 'border-white/10 bg-white/[.035]',
                ]}
                data-workout-target={target}
                data-workout-video={video}
                data-workout-title={title}
                data-workout-detail={detail}
                aria-pressed={index === 0 ? 'true' : 'false'}
                aria-label={`Assistir ao vídeo de ${title}`}
              >
                <span class="workout-icon flex size-11 items-center justify-center rounded-xl bg-blue-500/15 text-blue-300 transition">
                  <Icon size={20} strokeWidth={1.8} aria-hidden="true" />
                </span>
                <span>
                  <span class="flex items-center justify-between gap-4">
                    <strong class="font-semibold text-zinc-100">{title}</strong>
                    <span class="font-mono text-xs text-zinc-600">{order}</span>
                  </span>
                  <span class="mt-2 block text-sm leading-6 text-zinc-400">{detail}</span>
                </span>
              </button>
            </li>
          ))}
        </ul>

        <p class="mt-6 text-xs leading-6 text-zinc-500">
          Exemplo educativo. A prescrição final depende de avaliação, experiência, objetivo e
          resposta individual.
        </p>
      </div>

      <div class="rounded-[2rem] border border-white/10 bg-zinc-900/70 p-5 shadow-2xl shadow-blue-950/20 sm:p-8">
        <div class="border-b border-white/10 pb-6">
          <p class="text-xs font-semibold uppercase tracking-[.2em] text-blue-300">
            Execução em vídeo
          </p>
          <h3
            id="workout-video-title"
            class="mt-3 text-2xl font-semibold tracking-tight sm:text-3xl"
          >
            Supino inclinado com barra
          </h3>
          <p id="workout-video-description" class="mt-3 leading-7 text-zinc-400">
            Controle de amplitude e trajetória antes de progredir a carga.
          </p>
        </div>

        <div class="mt-6 overflow-hidden rounded-2xl border border-white/10 bg-zinc-950">
          <video
            id="workout-video"
            class="aspect-video w-full object-contain"
            controls
            preload="metadata"
            playsinline
            aria-label="Reprodutor do exercício Supino inclinado com barra"
          >
            <source src="/assets/provas/treino/supino-inclinado.mp4" type="video/mp4" />
            Seu navegador não suporta a reprodução deste vídeo.
          </video>
        </div>
        <p class="mt-4 text-xs leading-6 text-zinc-500">
          Clique em um cartão de exercício para trocar o vídeo e acompanhar a execução.
        </p>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  (() => {
    const video = document.querySelector('#workout-video');
    const title = document.querySelector('#workout-video-title');
    const description = document.querySelector('#workout-video-description');
    if (!(video instanceof HTMLVideoElement) || !title || !description) return;

    document.querySelectorAll('.workout-card').forEach((card) => {
      card.addEventListener('click', () => {
        const source = card.dataset.workoutVideo;
        if (!source) return;

        title.textContent = card.dataset.workoutTitle || '';
        description.textContent = card.dataset.workoutDetail || '';
        video.setAttribute(
          'aria-label',
          `Reprodutor do exercício ${card.dataset.workoutTitle || ''}`,
        );
        video.src = source;
        video.load();
        video.play().catch(() => {});
      });
    });
  })();
</script>
