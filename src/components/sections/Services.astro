---
export interface Service {
  title: string;
  description: string;
  detail?: string;
  image?: string;
  imageAlt?: string;
  modal?: {
    title: string;
    description: string;
    points: string[];
  };
}
export interface TrainingFocus {
  title: string;
  description: string;
}
export interface Props {
  eyebrow?: string;
  title: string;
  intro?: string;
  services: Service[];
  objectives?: string[];
  focusAreas?: TrainingFocus[];
}
const {
  eyebrow = 'Programas de treinamento',
  title,
  intro,
  services,
  objectives = [],
  focusAreas = [],
} = Astro.props;
---

<section
  id="servicos"
  class="bg-[#f7f7f4] px-5 py-[var(--space-section)] text-zinc-950 sm:px-8 lg:px-12"
>
  <div class="editorial-container">
    <div class="max-w-2xl">
      <p class="eyebrow">03 / {eyebrow}</p>
      <h2 class="display-title mt-5 text-4xl font-semibold leading-[.95] sm:text-6xl">{title}</h2>
      {intro && <p class="mt-5 text-lg leading-7 text-zinc-600">{intro}</p>}
    </div>
    <div class="mt-14 grid gap-px overflow-hidden border border-zinc-300 bg-zinc-300 md:grid-cols-2">
      {services.map((service, i) => (
        <article class="group relative bg-white p-7 transition hover:bg-zinc-950 hover:text-white sm:p-10">
          {service.image && (
            <figure class="-mx-7 -mt-7 mb-8 overflow-hidden border-b border-zinc-200 bg-zinc-950 sm:-mx-10 sm:-mt-10">
              <img
                src={service.image}
                alt={service.imageAlt ?? ''}
                width="1536"
                height="2048"
                loading="lazy"
                class="aspect-[3/2] w-full object-cover grayscale-[8%] transition duration-700 group-hover:scale-[1.03]"
              />
            </figure>
          )}
          <div class="flex items-start justify-between gap-4">
            <span class="font-mono text-sm text-blue-600 group-hover:text-blue-300">0{i + 1}</span>
            {service.detail && (
              <span class="border-b border-zinc-300 pb-1 text-xs uppercase tracking-[.16em] text-zinc-500 group-hover:border-zinc-700 group-hover:text-zinc-400">
                {service.detail}
              </span>
            )}
          </div>
          <h3 class="display-title mt-16 text-3xl font-semibold tracking-tight text-zinc-950 sm:text-4xl">
            {service.title}
          </h3>
          <p class="mt-4 max-w-md leading-7 text-zinc-600 group-hover:text-zinc-300">
            {service.description.startsWith('[Texto')
              ? 'Conteúdo reservado para complementar este programa.'
              : service.description}
          </p>
          {service.modal && (
            <button
              type="button"
              data-service-open
              class="mt-8 inline-flex min-h-11 items-center text-sm font-semibold text-zinc-950 underline decoration-blue-500 decoration-2 underline-offset-4"
            >
              Ver descrição{' '}
              <span aria-hidden="true" class="ml-2 transition group-hover:translate-x-1">
                →
              </span>
            </button>
          )}
          {service.modal && (
            <dialog class="service-dialog m-auto w-[min(92vw,36rem)] rounded-3xl border border-zinc-200 bg-white p-0 text-zinc-950 shadow-2xl backdrop:bg-zinc-950/70">
              <div class="p-7 sm:p-9">
                <div class="flex items-start justify-between gap-6">
                  <div>
                    <p class="text-xs font-semibold uppercase tracking-[.18em] text-blue-600">
                      Programa
                    </p>
                    <h4 class="mt-3 text-2xl font-semibold tracking-tight">
                      {service.modal.title}
                    </h4>
                  </div>
                  <button
                    type="button"
                    data-service-close
                    class="flex size-11 shrink-0 items-center justify-center rounded-full bg-zinc-100 text-xl text-zinc-600 transition hover:bg-zinc-200 focus:outline-none focus:ring-2 focus:ring-blue-500"
                    aria-label="Fechar detalhes do programa"
                  >
                    ×
                  </button>
                </div>
                <p class="mt-5 leading-7 text-zinc-600">
                  {service.modal.description.startsWith('[Texto')
                    ? 'Conteúdo reservado para complementar este programa.'
                    : service.modal.description}
                </p>
                <ul class="mt-6 space-y-3 border-t border-zinc-200 pt-6">
                  {service.modal.points.map((point) => (
                    <li class="flex gap-3 text-sm leading-6 text-zinc-700">
                      <span class="mt-2 size-2 shrink-0 rounded-full bg-blue-600"></span>
                      {point}
                    </li>
                  ))}
                </ul>
                <button
                  type="button"
                  data-service-close
                  class="mt-8 inline-flex min-h-12 items-center rounded-full bg-zinc-950 px-6 text-sm font-semibold text-white transition hover:bg-zinc-800"
                >
                  Fechar descrição
                </button>
              </div>
            </dialog>
          )}
        </article>
      ))}
    </div>
    {objectives.length > 0 && (
      <div class="mt-16 border-t border-zinc-300 pt-8">
        <div class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
          <h3 class="display-title text-3xl font-semibold tracking-tight text-zinc-950">
            Principais objetivos
          </h3>
          <span class="font-mono text-xs text-zinc-500">01—07</span>
        </div>
        <ul class="mt-7 grid gap-3 border-y border-zinc-200 py-6 sm:grid-cols-2 lg:grid-cols-4">
          {objectives.map((objective) => (
            <li class="flex gap-3 text-base leading-7 text-zinc-600">
              <span class="mt-3 size-2 shrink-0 rounded-full bg-blue-600"></span>
              {objective}
            </li>
          ))}
        </ul>
      </div>
    )}
    {focusAreas.length > 0 && (
      <div class="mt-16 border-t border-zinc-300 pt-8">
        <h3 class="display-title text-3xl font-semibold tracking-tight text-zinc-950">
          Abordagens por objetivo
        </h3>
        <div class="mt-7 grid gap-px overflow-hidden border border-zinc-300 bg-zinc-300 lg:grid-cols-3">
          {focusAreas.map((area, i) => (
            <article class="bg-white p-6 sm:p-8">
              <div class="flex items-center justify-between">
                <span class="font-mono text-xs text-blue-600">0{i + 1}</span>
                <span class="text-xs uppercase tracking-[.14em] text-zinc-400">Foco</span>
              </div>
              <h4 class="display-title mt-10 text-2xl font-semibold tracking-tight text-zinc-950">
                {area.title}
              </h4>
              <p class="mt-4 whitespace-pre-line leading-7 text-zinc-600">{area.description}</p>
            </article>
          ))}
        </div>
      </div>
    )}
  </div>
</section>

<script is:inline>
  document.querySelectorAll('[data-service-open]').forEach((trigger) => {
    trigger.addEventListener('click', () => {
      trigger.closest('article')?.querySelector('dialog')?.showModal();
    });
  });

  document.querySelectorAll('[data-service-close]').forEach((trigger) => {
    trigger.addEventListener('click', () => trigger.closest('dialog')?.close());
  });

  document.querySelectorAll('.service-dialog').forEach((dialog) => {
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });
  });
</script>
