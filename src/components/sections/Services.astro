---
export interface Service {
  title: string;
  description: string;
  detail?: string;
  modal?: {
    title: string;
    description: string;
    points: string[];
  };
}
export interface TrainingFocus {
  title: string;
  description: string;
}
export interface Props {
  eyebrow?: string;
  title: string;
  intro?: string;
  services: Service[];
  objectives?: string[];
  focusAreas?: TrainingFocus[];
}
const {
  eyebrow = 'Programas de treinamento',
  title,
  intro,
  services,
  objectives = [],
  focusAreas = [],
} = Astro.props;
---

<section id="servicos" class="bg-zinc-50 px-5 py-20 sm:px-8 lg:px-12 lg:py-28">
  <div class="mx-auto max-w-7xl">
    <div class="max-w-2xl">
      <p class="text-xs font-semibold uppercase tracking-[.2em] text-blue-600">{eyebrow}</p>
      <h2 class="mt-4 text-4xl font-semibold tracking-[-.045em] text-zinc-950 sm:text-5xl">
        {title}
      </h2>
      {intro && <p class="mt-5 text-lg leading-7 text-zinc-600">{intro}</p>}
    </div>
    <div class="mt-12 grid gap-4 md:grid-cols-2">
      {services.map((service, i) => (
        <article class="group rounded-3xl border border-zinc-200 bg-white p-7 transition hover:-translate-y-1 hover:border-blue-200 hover:shadow-xl hover:shadow-zinc-200/60 sm:p-9">
          <div class="flex items-start justify-between gap-4">
            <span class="font-mono text-sm text-blue-600">0{i + 1}</span>
            {service.detail && (
              <span class="rounded-full bg-zinc-100 px-3 py-1 text-xs text-zinc-600">
                {service.detail}
              </span>
            )}
          </div>
          <h3 class="mt-12 text-2xl font-semibold tracking-tight text-zinc-950">{service.title}</h3>
          <p class="mt-3 max-w-md leading-7 text-zinc-600">{service.description}</p>
          {service.modal && (
            <button
              type="button"
              data-service-open
              class="mt-7 inline-flex min-h-11 items-center text-sm font-semibold text-zinc-950 underline decoration-blue-500 decoration-2 underline-offset-4"
            >
              Ver descrição{' '}
              <span aria-hidden="true" class="ml-2 transition group-hover:translate-x-1">
                →
              </span>
            </button>
          )}
          {service.modal && (
            <dialog class="service-dialog m-auto w-[min(92vw,36rem)] rounded-3xl border border-zinc-200 bg-white p-0 text-zinc-950 shadow-2xl backdrop:bg-zinc-950/70">
              <div class="p-7 sm:p-9">
                <div class="flex items-start justify-between gap-6">
                  <div>
                    <p class="text-xs font-semibold uppercase tracking-[.18em] text-blue-600">
                      Programa
                    </p>
                    <h4 class="mt-3 text-2xl font-semibold tracking-tight">
                      {service.modal.title}
                    </h4>
                  </div>
                  <button
                    type="button"
                    data-service-close
                    class="flex size-11 shrink-0 items-center justify-center rounded-full bg-zinc-100 text-xl text-zinc-600 transition hover:bg-zinc-200 focus:outline-none focus:ring-2 focus:ring-blue-500"
                    aria-label="Fechar detalhes do programa"
                  >
                    ×
                  </button>
                </div>
                <p class="mt-5 leading-7 text-zinc-600">{service.modal.description}</p>
                <ul class="mt-6 space-y-3 border-t border-zinc-200 pt-6">
                  {service.modal.points.map((point) => (
                    <li class="flex gap-3 text-sm leading-6 text-zinc-700">
                      <span class="mt-2 size-2 shrink-0 rounded-full bg-blue-600"></span>
                      {point}
                    </li>
                  ))}
                </ul>
                <button
                  type="button"
                  data-service-close
                  class="mt-8 inline-flex min-h-12 items-center rounded-full bg-zinc-950 px-6 text-sm font-semibold text-white transition hover:bg-zinc-800"
                >
                  Fechar descrição
                </button>
              </div>
            </dialog>
          )}
        </article>
      ))}
    </div>
    {objectives.length > 0 && (
      <div class="mt-12 border-t border-zinc-200 pt-8">
        <h3 class="text-2xl font-semibold tracking-tight text-zinc-950">Principais objetivos</h3>
        <ul class="mt-6 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
          {objectives.map((objective) => (
            <li class="flex gap-3 text-base leading-7 text-zinc-600">
              <span class="mt-3 size-2 shrink-0 rounded-full bg-blue-600"></span>
              {objective}
            </li>
          ))}
        </ul>
      </div>
    )}
    {focusAreas.length > 0 && (
      <div class="mt-14 border-t border-zinc-200 pt-8">
        <h3 class="text-2xl font-semibold tracking-tight text-zinc-950">Abordagens por objetivo</h3>
        <div class="mt-6 grid gap-5 lg:grid-cols-3">
          {focusAreas.map((area) => (
            <article class="rounded-3xl border border-zinc-200 bg-white p-6 sm:p-7">
              <h4 class="text-xl font-semibold tracking-tight text-zinc-950">{area.title}</h4>
              <p class="mt-4 whitespace-pre-line leading-7 text-zinc-600">{area.description}</p>
            </article>
          ))}
        </div>
      </div>
    )}
  </div>
</section>

<script is:inline>
  document.querySelectorAll('[data-service-open]').forEach((trigger) => {
    trigger.addEventListener('click', () => {
      trigger.closest('article')?.querySelector('dialog')?.showModal();
    });
  });

  document.querySelectorAll('[data-service-close]').forEach((trigger) => {
    trigger.addEventListener('click', () => trigger.closest('dialog')?.close());
  });

  document.querySelectorAll('.service-dialog').forEach((dialog) => {
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });
  });
</script>
