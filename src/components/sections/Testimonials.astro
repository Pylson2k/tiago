---
export interface Testimonial {
  quote: string;
  name: string;
  context?: string;
}
export interface TestimonialImage {
  src: string;
  alt: string;
  label?: string;
  authorization?: string;
}
export interface Props {
  title: string;
  testimonials: Testimonial[];
  images?: TestimonialImage[];
  videoSrc?: string;
}
const { title, testimonials, images = [], videoSrc } = Astro.props;
---

<section id="depoimentos" class="bg-white px-5 py-20 sm:px-8 lg:px-12 lg:py-28">
  <div class="mx-auto max-w-7xl">
    <p class="text-xs font-semibold uppercase tracking-[.2em] text-blue-600">Experiências reais</p>
    <h2 class="mt-4 max-w-xl text-4xl font-semibold tracking-[-.045em] text-zinc-950 sm:text-5xl">
      {title}
    </h2>
    {testimonials.length > 0 && (
      <div class="mt-12 grid gap-4 md:grid-cols-3">
        {testimonials.map((item) => (
          <figure class="flex min-h-56 flex-col justify-between rounded-3xl bg-zinc-950 p-7 text-white sm:p-8">
            <blockquote class="text-lg leading-8 text-zinc-200">“{item.quote}”</blockquote>
            <figcaption class="mt-8 border-t border-white/10 pt-4">
              <p class="font-semibold">{item.name}</p>
              {item.context && <p class="mt-1 text-sm text-zinc-400">{item.context}</p>}
            </figcaption>
          </figure>
        ))}
      </div>
    )}
    {(videoSrc || images.length > 0) && (
      <div class="mt-12">
        <h3 class="text-2xl font-semibold tracking-tight text-zinc-950">
          Registros dos depoimentos
        </h3>
        {videoSrc && (
          <figure class="mt-6 overflow-hidden rounded-2xl border border-zinc-200 bg-zinc-950">
            <video
              class="max-h-[min(38rem,70svh)] w-full object-contain"
              controls
              preload="metadata"
              playsinline
            >
              <source src={videoSrc} type="video/mp4" />
              Seu navegador não suporta a reprodução deste vídeo.
            </video>
            <figcaption class="p-4 text-sm text-zinc-300">
              Registro em vídeo do trabalho de Tiago Filadelfo.
            </figcaption>
          </figure>
        )}
        <div
          class:list={['grid gap-4 sm:grid-cols-2 lg:grid-cols-4', videoSrc ? 'mt-8' : 'mt-6']}
          aria-label="Prints de depoimentos de alunos"
        >
          {images.map((item) => (
            <figure class="overflow-hidden rounded-2xl border border-zinc-200 bg-zinc-50">
              <img
                src={item.src}
                alt={item.alt}
                loading="lazy"
                class="aspect-[4/5] w-full bg-zinc-100 object-contain"
              />
              <figcaption class="p-4">
                {item.label && <p class="text-sm font-medium text-zinc-800">{item.label}</p>}
                {item.authorization && (
                  <p class="mt-2 text-xs leading-5 text-zinc-500">{item.authorization}</p>
                )}
              </figcaption>
            </figure>
          ))}
        </div>
      </div>
    )}
  </div>
</section>
