---
export interface Testimonial {
  quote: string;
  name: string;
  context?: string;
}
export interface TestimonialImage {
  src: string;
  alt: string;
  label?: string;
  authorization?: string;
}
export interface Props {
  title: string;
  testimonials: Testimonial[];
  images?: TestimonialImage[];
  videoSrc?: string;
}
const { title, testimonials, images = [], videoSrc } = Astro.props;
---

<section id="depoimentos" class="bg-white px-5 py-[var(--space-section)] sm:px-8 lg:px-12">
  <div class="editorial-container">
    <p class="eyebrow">07 / Depoimentos</p>
    <h2 class="display-title mt-5 max-w-xl text-4xl font-semibold leading-[.95] tracking-[-.045em] text-zinc-950 sm:text-6xl">
      {title}
    </h2>
    {testimonials.length > 0 && (
      <div class="mt-12 grid gap-4 md:grid-cols-3">
        {testimonials.map((item) => (
          <figure class="flex min-h-56 flex-col justify-between rounded-3xl bg-zinc-950 p-7 text-white sm:p-8">
            <blockquote class="text-lg leading-8 text-zinc-200">“{item.quote}”</blockquote>
            <figcaption class="mt-8 border-t border-white/10 pt-4">
              <p class="font-semibold">{item.name}</p>
              {item.context && <p class="mt-1 text-sm text-zinc-400">{item.context}</p>}
            </figcaption>
          </figure>
        ))}
      </div>
    )}
    {(videoSrc || images.length > 0) && (
      <div class="mt-12">
        <h3 class="display-title text-3xl font-semibold tracking-tight text-zinc-950">
          Vídeo e prints autorizados de alunos
        </h3>
        {videoSrc && (
          <figure class="mt-6 overflow-hidden rounded-2xl border border-zinc-200 bg-zinc-950">
            <video
              class="max-h-[min(38rem,70svh)] w-full object-contain"
              controls
              preload="metadata"
              playsinline
            >
              <source src={videoSrc} type="video/mp4" />
              Seu navegador não suporta a reprodução deste vídeo.
            </video>
            <figcaption class="p-4 text-sm text-zinc-300">
              Registro em vídeo do trabalho de Tiago Filadelfo.
            </figcaption>
          </figure>
        )}
        <div
          class:list={['grid gap-4 sm:grid-cols-2 lg:grid-cols-4', videoSrc ? 'mt-8' : 'mt-6']}
          aria-label="Prints de depoimentos de alunos"
        >
          {images.map((item) => (
            <figure class="overflow-hidden border border-zinc-200 bg-zinc-50">
              <button
                type="button"
                class="block w-full cursor-zoom-in text-left focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-600 focus-visible:ring-inset"
                data-testimonial-trigger={`testimonial-image-${item.src.replace(/[^a-zA-Z0-9]/g, '-')}`}
                aria-label={`Ampliar ${item.alt}`}
              >
                <img
                  src={item.src}
                  alt={item.alt}
                  loading="lazy"
                  class="aspect-[4/5] w-full bg-zinc-100 object-contain"
                />
              </button>
              <figcaption class="p-4">
                {item.label && <p class="text-sm font-medium text-zinc-800">{item.label}</p>}
                {item.authorization && (
                  <p class="mt-2 text-xs leading-5 text-zinc-500">{item.authorization}</p>
                )}
              </figcaption>
              <dialog
                id={`testimonial-image-${item.src.replace(/[^a-zA-Z0-9]/g, '-')}`}
                class="testimonial-dialog m-auto max-h-[92svh] w-[min(94vw,56rem)] rounded-2xl bg-zinc-950 p-3 text-white shadow-2xl backdrop:bg-zinc-950/80"
              >
                <div class="flex items-center justify-end pb-2">
                  <button
                    type="button"
                    class="inline-flex min-h-10 items-center rounded-full border border-white/20 px-4 text-sm text-zinc-200 transition hover:bg-white/10 focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-300"
                    data-testimonial-close
                  >
                    Fechar
                  </button>
                </div>
                <img src={item.src} alt={item.alt} class="max-h-[78svh] w-full object-contain" />
                <p class="px-2 pb-2 pt-3 text-xs text-zinc-400">
                  Clique em Fechar ou pressione Esc para retornar.
                </p>
              </dialog>
            </figure>
          ))}
        </div>
      </div>
    )}
  </div>
</section>

<script is:inline>
  document.querySelectorAll('[data-testimonial-trigger]').forEach((trigger) => {
    trigger.addEventListener('click', () => {
      const id = trigger.getAttribute('data-testimonial-trigger');
      const dialog = id ? document.getElementById(id) : null;
      if (dialog instanceof HTMLDialogElement) dialog.showModal();
    });
  });
  document.querySelectorAll('[data-testimonial-close]').forEach((close) => {
    close.addEventListener('click', () => close.closest('dialog')?.close());
  });
  document.querySelectorAll('.testimonial-dialog').forEach((dialog) => {
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });
  });
</script>
