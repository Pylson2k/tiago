---
export interface Testimonial {
  quote: string;
  name: string;
  context?: string;
}
export interface Props {
  title: string;
  testimonials: Testimonial[];
}
const { title, testimonials } = Astro.props;
---

<section id="depoimentos" class="bg-white px-5 py-20 sm:px-8 lg:px-12 lg:py-28">
  <div class="mx-auto max-w-7xl">
    <p class="text-xs font-semibold uppercase tracking-[.2em] text-blue-600">Experiências reais</p>
    <h2 class="mt-4 max-w-xl text-4xl font-semibold tracking-[-.045em] text-zinc-950 sm:text-5xl">
      {title}
    </h2>
    <div class="mt-12 grid gap-4 md:grid-cols-3">
      {testimonials.map((item) => (
        <figure class="flex min-h-56 flex-col justify-between rounded-3xl bg-zinc-950 p-7 text-white sm:p-8">
          <blockquote class="text-lg leading-8 text-zinc-200">“{item.quote}”</blockquote>
          <figcaption class="mt-8 border-t border-white/10 pt-4">
            <p class="font-semibold">{item.name}</p>
            {item.context && <p class="mt-1 text-sm text-zinc-400">{item.context}</p>}
          </figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>
