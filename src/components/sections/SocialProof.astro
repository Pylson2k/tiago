---
export interface ResultCase {
  title: string;
  description?: string;
  image?: { src: string; alt: string };
  before?: { src: string; alt: string; width?: number; height?: number };
  after?: { src: string; alt: string; width?: number; height?: number };
  authorization?: string;
}

export interface TestimonialImage {
  src: string;
  alt: string;
  label?: string;
  authorization?: string;
}

export interface Props {
  title: string;
  intro?: string;
  cases?: ResultCase[];
  testimonials?: TestimonialImage[];
  disclaimer?: string;
}

const { title, intro, cases = [], testimonials = [], disclaimer } = Astro.props;
---

<section
  id="provas"
  class="bg-[#f7f5e9] px-5 py-[var(--space-section)] text-zinc-950 sm:px-8 lg:px-12"
  aria-labelledby="social-proof-title"
>
  <div class="editorial-container">
    <div class="max-w-2xl">
      <p class="eyebrow text-orange-600">05 / Registros de resultados</p>
      <h2
        id="social-proof-title"
        class="display-title mt-5 text-4xl font-semibold leading-[.95] tracking-[-.045em] sm:text-6xl"
      >
        {title}
      </h2>
      {intro && <p class="mt-5 text-lg leading-8 text-zinc-600">{intro}</p>}
    </div>

    {cases.length > 0 && (
      <div class="mt-14 grid gap-8">
        {cases.map((item, index) => (
          <article class="group grid overflow-hidden border border-zinc-300 bg-white lg:grid-cols-[1.15fr_.85fr]">
            {item.image ? (
              <figure class="relative overflow-hidden bg-zinc-950 p-1 lg:border-r lg:border-zinc-300">
                <div
                  class="comparison-reveal"
                  data-comparison
                  role="slider"
                  tabindex="0"
                  aria-label="Controle de comparação entre antes e depois"
                  aria-valuemin="0"
                  aria-valuemax="100"
                  aria-valuenow="0"
                >
                  <img
                    src={item.image.src}
                    alt={item.image.alt}
                    loading="lazy"
                    class="comparison-reveal__sizer"
                  />
                  <img
                    src={item.image.src}
                    alt=""
                    aria-hidden="true"
                    loading="lazy"
                    class="comparison-reveal__layer comparison-reveal__after"
                  />
                  <div class="comparison-reveal__before" data-comparison-before>
                    <img
                      src={item.image.src}
                      alt=""
                      aria-hidden="true"
                      loading="lazy"
                      class="comparison-reveal__layer"
                    />
                  </div>
                  <span class="comparison-reveal__label comparison-reveal__label--before">
                    Antes
                  </span>
                  <span class="comparison-reveal__label comparison-reveal__label--after">
                    Depois
                  </span>
                  <span class="comparison-reveal__handle" aria-hidden="true">
                    ↔
                  </span>
                </div>
                <figcaption class="px-3 py-3 text-[0.68rem] font-semibold uppercase tracking-[.16em] text-zinc-500">
                  Passe o cursor ou toque para comparar
                </figcaption>
              </figure>
            ) : item.before && item.after ? (
              <div class="grid grid-cols-2 gap-2 bg-zinc-950 p-2 lg:border-r lg:border-zinc-300">
                <figure class="overflow-hidden bg-black">
                  <img
                    src={item.before.src}
                    alt={item.before.alt}
                    loading="lazy"
                    width={item.before.width}
                    height={item.before.height}
                    class="h-[clamp(15rem,32vw,22rem)] w-full object-contain"
                  />
                  <figcaption class="border-t border-white/10 px-3 py-2 text-[0.68rem] font-semibold uppercase tracking-[.16em] text-zinc-400">
                    Antes
                  </figcaption>
                </figure>
                <figure class="overflow-hidden bg-black">
                  <img
                    src={item.after.src}
                    alt={item.after.alt}
                    loading="lazy"
                    width={item.after.width}
                    height={item.after.height}
                    class="h-[clamp(15rem,32vw,22rem)] w-full object-contain"
                  />
                  <figcaption class="border-t border-white/10 px-3 py-2 text-[0.68rem] font-semibold uppercase tracking-[.16em] text-zinc-400">
                    Depois
                  </figcaption>
                </figure>
              </div>
            ) : null}
            <div class="p-6 sm:p-8">
              <p class="font-mono text-xs text-orange-600">CASO 0{index + 1} / DOCUMENTADO</p>
              <h3 class="display-title mt-4 text-2xl font-semibold tracking-tight sm:text-3xl">
                {item.title}
              </h3>
              {item.description && <p class="mt-3 leading-7 text-zinc-600">{item.description}</p>}
              {item.authorization && (
                <p class="mt-5 text-xs leading-5 text-zinc-500">{item.authorization}</p>
              )}
            </div>
          </article>
        ))}
      </div>
    )}

    {testimonials.length > 0 && (
      <div class="mt-20">
        <div class="flex items-end justify-between gap-4">
          <h3 class="text-2xl font-semibold tracking-tight">Quem treinou, conta</h3>
          <span class="hidden text-xs uppercase tracking-[.16em] text-zinc-500 sm:block">
            Depoimentos
          </span>
        </div>
        <p class="mt-3 text-xs text-zinc-500 sm:hidden">Deslize para ver todos os depoimentos.</p>
        <div
          class="mt-5 flex snap-x snap-mandatory gap-4 overflow-x-auto pb-4 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden sm:mt-7 sm:grid sm:grid-cols-2 sm:overflow-visible sm:pb-0 lg:grid-cols-4"
          aria-label="Galeria de depoimentos"
          tabindex="0"
        >
          {testimonials.map((item) => (
            <figure class="min-w-[82vw] snap-start overflow-hidden rounded-2xl border border-white/10 bg-zinc-900 sm:min-w-0">
              <img
                src={item.src}
                alt={item.alt}
                loading="lazy"
                class="aspect-[4/5] w-full bg-black object-contain"
              />
              <figcaption class="p-4">
                {item.label && <p class="text-sm font-medium text-zinc-200">{item.label}</p>}
                {item.authorization && (
                  <p class="mt-2 text-xs leading-5 text-zinc-500">{item.authorization}</p>
                )}
              </figcaption>
            </figure>
          ))}
        </div>
      </div>
    )}

    {disclaimer && (
      <p class="mt-12 max-w-3xl border-l border-blue-400/60 pl-4 text-xs leading-6 text-zinc-500">
        {disclaimer}
      </p>
    )}
  </div>
</section>

<script is:inline>
  document.querySelectorAll('[data-comparison]').forEach((comparison) => {
    const before = comparison.querySelector('[data-comparison-before]');
    if (!(before instanceof HTMLElement)) return;
    const setPercent = (percent) => {
      const value = Math.max(0, Math.min(100, percent));
      before.style.clipPath = `inset(0 ${100 - value}% 0 0)`;
      comparison.setAttribute('aria-valuenow', String(Math.round(value)));
    };
    const update = (event) => {
      const point = event.touches?.[0] ?? event;
      const rect = comparison.getBoundingClientRect();
      const percent = Math.max(0, Math.min(100, ((point.clientX - rect.left) / rect.width) * 100));
      setPercent(percent);
    };
    comparison.addEventListener('pointermove', update);
    comparison.addEventListener('touchmove', update, { passive: true });
    comparison.addEventListener('pointerleave', () => {
      setPercent(0);
    });
    comparison.addEventListener('keydown', (event) => {
      const current = Number(comparison.getAttribute('aria-valuenow') ?? 0);
      if (event.key === 'ArrowRight' || event.key === 'ArrowUp') {
        event.preventDefault();
        setPercent(current + 5);
      } else if (event.key === 'ArrowLeft' || event.key === 'ArrowDown') {
        event.preventDefault();
        setPercent(current - 5);
      } else if (event.key === 'Home') {
        event.preventDefault();
        setPercent(0);
      } else if (event.key === 'End') {
        event.preventDefault();
        setPercent(100);
      }
    });
  });
</script>
