---
export interface ResultCase {
  title: string;
  description?: string;
  image?: { src: string; alt: string };
  before?: { src: string; alt: string };
  after?: { src: string; alt: string };
  authorization?: string;
}

export interface TestimonialImage {
  src: string;
  alt: string;
  label?: string;
  authorization?: string;
}

export interface Props {
  title: string;
  intro?: string;
  cases?: ResultCase[];
  testimonials?: TestimonialImage[];
  disclaimer?: string;
}

const { title, intro, cases = [], testimonials = [], disclaimer } = Astro.props;
---

<section
  id="provas"
  class="bg-zinc-950 px-5 py-20 text-white sm:px-8 lg:px-12 lg:py-28"
  aria-labelledby="social-proof-title"
>
  <div class="mx-auto max-w-7xl">
    <div class="max-w-2xl">
      <p class="text-xs font-semibold uppercase tracking-[.2em] text-blue-300">Provas sociais</p>
      <h2
        id="social-proof-title"
        class="mt-4 text-4xl font-semibold tracking-[-.045em] sm:text-5xl"
      >
        {title}
      </h2>
      {intro && <p class="mt-5 text-lg leading-8 text-zinc-400">{intro}</p>}
    </div>

    {cases.length > 0 && (
      <div class="mt-12 grid gap-5 lg:grid-cols-2">
        {cases.map((item, index) => (
          <article class="overflow-hidden rounded-[1.75rem] border border-white/10 bg-zinc-900">
            {item.image ? (
              <figure class="bg-zinc-950 p-1">
                <img
                  src={item.image.src}
                  alt={item.image.alt}
                  loading="lazy"
                  class="mx-auto max-h-[min(36rem,70svh)] w-full object-contain"
                />
                <figcaption class="px-3 py-3 text-[0.68rem] font-semibold uppercase tracking-[.16em] text-zinc-500">
                  Comparativo antes e depois
                </figcaption>
              </figure>
            ) : (
              <div class="grid grid-cols-2 gap-1 bg-zinc-950 p-1">
                {item.before && (
                  <figure>
                    <img
                      src={item.before.src}
                      alt={item.before.alt}
                      loading="lazy"
                      class="h-[26rem] w-full bg-black object-contain sm:h-[32rem]"
                    />
                    <figcaption class="px-3 py-3 text-[0.68rem] font-semibold uppercase tracking-[.16em] text-zinc-500">
                      Antes
                    </figcaption>
                  </figure>
                )}
                {item.after && (
                  <figure>
                    <img
                      src={item.after.src}
                      alt={item.after.alt}
                      loading="lazy"
                      class="h-[26rem] w-full bg-black object-contain sm:h-[32rem]"
                    />
                    <figcaption class="px-3 py-3 text-[0.68rem] font-semibold uppercase tracking-[.16em] text-zinc-500">
                      Depois
                    </figcaption>
                  </figure>
                )}
              </div>
            )}
            <div class="p-6 sm:p-7">
              <p class="font-mono text-xs text-blue-300">CASO 0{index + 1}</p>
              <h3 class="mt-3 text-2xl font-semibold tracking-tight">{item.title}</h3>
              {item.description && <p class="mt-3 leading-7 text-zinc-400">{item.description}</p>}
              {item.authorization && (
                <p class="mt-5 text-xs leading-5 text-zinc-500">{item.authorization}</p>
              )}
            </div>
          </article>
        ))}
      </div>
    )}

    {testimonials.length > 0 && (
      <div class="mt-20">
        <div class="flex items-end justify-between gap-4">
          <h3 class="text-2xl font-semibold tracking-tight">Quem treinou, conta</h3>
          <span class="hidden text-xs uppercase tracking-[.16em] text-zinc-500 sm:block">
            Depoimentos
          </span>
        </div>
        <p class="mt-3 text-xs text-zinc-500 sm:hidden">Deslize para ver todos os depoimentos.</p>
        <div
          class="mt-5 flex snap-x snap-mandatory gap-4 overflow-x-auto pb-4 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden sm:mt-7 sm:grid sm:grid-cols-2 sm:overflow-visible sm:pb-0 lg:grid-cols-4"
          aria-label="Galeria de depoimentos"
          tabindex="0"
        >
          {testimonials.map((item) => (
            <figure class="min-w-[82vw] snap-start overflow-hidden rounded-2xl border border-white/10 bg-zinc-900 sm:min-w-0">
              <img
                src={item.src}
                alt={item.alt}
                loading="lazy"
                class="aspect-[4/5] w-full bg-black object-contain"
              />
              <figcaption class="p-4">
                {item.label && <p class="text-sm font-medium text-zinc-200">{item.label}</p>}
                {item.authorization && (
                  <p class="mt-2 text-xs leading-5 text-zinc-500">{item.authorization}</p>
                )}
              </figcaption>
            </figure>
          ))}
        </div>
      </div>
    )}

    {disclaimer && (
      <p class="mt-12 max-w-3xl border-l border-blue-400/60 pl-4 text-xs leading-6 text-zinc-500">
        {disclaimer}
      </p>
    )}
  </div>
</section>
