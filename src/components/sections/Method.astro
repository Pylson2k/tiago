---
export interface Step {
  number: string;
  title: string;
  description: string;
}
export interface Props {
  title: string;
  intro?: string;
  steps: Step[];
}
const { title, intro, steps } = Astro.props;
---

<section id="metodo" class="bg-zinc-950 px-5 py-20 text-white sm:px-8 lg:px-12 lg:py-28">
  <div class="mx-auto max-w-7xl">
    <div class="grid gap-12 lg:grid-cols-[.75fr_1.25fr] lg:gap-24">
      <div>
        <p class="text-xs font-semibold uppercase tracking-[.2em] text-blue-300">O processo</p>
        <h2 class="mt-4 text-4xl font-semibold tracking-[-.045em] sm:text-5xl">{title}</h2>
        {intro && <p class="mt-6 leading-7 text-zinc-400">{intro}</p>}
      </div>
      <ol class="divide-y divide-white/10 border-y border-white/10">
        {steps.map((step) => (
          <li class="grid gap-4 py-7 sm:grid-cols-[5rem_1fr] sm:gap-8">
            <span class="font-mono text-sm text-blue-300">{step.number}</span>
            <div>
              <h3 class="text-xl font-medium">{step.title}</h3>
              <p class="mt-2 leading-7 text-zinc-400">{step.description}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>
