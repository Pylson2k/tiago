---
export interface Props {
  eyebrow?: string;
  title: string;
  description: string;
  image: string;
  imageAlt: string;
  primaryHref?: string;
  primaryLabel?: string;
  secondaryHref?: string;
  secondaryLabel?: string;
}
const {
  eyebrow = 'Treinamento individualizado',
  title,
  description,
  image,
  imageAlt,
  primaryHref,
  primaryLabel = 'Ver seção',
  secondaryHref,
  secondaryLabel = 'Ver resultados',
} = Astro.props;
---

<section
  id="inicio"
  class="hero-editorial relative isolate overflow-hidden bg-[#f7f5e9] text-zinc-950"
  aria-labelledby="hero-title"
>
  <div class="absolute inset-0 -z-10 bg-[radial-gradient(circle_at_76%_18%,rgba(255,94,47,.18),transparent_32%),linear-gradient(125deg,#f7f5e9_0%,#ebe8d9_100%)]"></div>
  <div class="editorial-container flex min-h-[92svh] flex-col items-center pb-10 pt-32 text-center sm:pb-16 lg:pt-36">
    <div class="flex max-w-5xl flex-col items-center">
      <p class="eyebrow mb-7 rounded-sm bg-white/80 px-3 py-2 text-orange-600 shadow-sm">
        01 / {eyebrow}
      </p>
      <h1
        id="hero-title"
        class="display-title max-w-5xl text-[clamp(3.1rem,7.5vw,7.75rem)] font-semibold leading-[.88]"
      >
        {title}
      </h1>
      <p class="mt-8 max-w-2xl text-base leading-7 text-zinc-600 sm:text-lg sm:leading-8">
        {description}
      </p>
      {primaryHref || secondaryHref ? (
        <div class="mt-9 flex flex-wrap items-center justify-center gap-3">
          {primaryHref && (
            <a
              href={primaryHref}
              class="inline-flex min-h-12 items-center justify-center rounded-full bg-orange-600 px-6 text-sm font-semibold text-white transition hover:bg-orange-500 focus:outline-none focus:ring-2 focus:ring-orange-300 focus:ring-offset-2 focus:ring-offset-[#f7f5e9]"
            >
              {primaryLabel}
            </a>
          )}
          {secondaryHref && (
            <a
              href={secondaryHref}
              class="inline-flex min-h-12 items-center justify-center rounded-full border border-zinc-950/20 px-6 text-sm font-semibold text-zinc-950 transition hover:border-zinc-950/60 focus:outline-none focus:ring-2 focus:ring-orange-400"
            >
              {secondaryLabel}
            </a>
          )}
        </div>
      ) : null}
    </div>
    <figure class="hero-editorial__media relative mt-12 w-full max-w-3xl overflow-hidden border border-zinc-950/10 bg-zinc-900 shadow-2xl shadow-orange-950/20">
      <img
        src={image}
        alt={imageAlt}
        class="aspect-[5/6] w-full object-cover grayscale-[15%] transition duration-700 hover:scale-105"
        loading="eager"
      />
      <figcaption class="absolute bottom-4 left-4 rounded-full bg-white/85 px-4 py-2 text-xs text-zinc-800 backdrop-blur">
        Registro de atuação profissional
      </figcaption>
    </figure>
  </div>
</section>
