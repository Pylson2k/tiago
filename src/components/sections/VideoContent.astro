---
export interface VideoCard {
  title: string;
  description: string;
  src?: string;
}

export interface Props {
  title: string;
  intro?: string;
  cards: VideoCard[];
}

const { title, intro, cards } = Astro.props;
---

<section id="videos" class="bg-zinc-100 px-5 py-[var(--space-section)] sm:px-8 lg:px-12">
  <div class="editorial-container">
    <p class="eyebrow">Conteúdos em vídeo</p>
    <h2 class="display-title mt-5 max-w-2xl text-4xl font-semibold leading-[.95] tracking-[-.045em] text-zinc-950 sm:text-6xl">
      {title}
    </h2>
    {intro && <p class="mt-5 max-w-2xl text-lg leading-8 text-zinc-600">{intro}</p>}
    <div class="mt-14 grid gap-px overflow-hidden border border-zinc-300 bg-zinc-300 md:grid-cols-2">
      {cards.map((card, index) => (
        <article class="overflow-hidden bg-white">
          {card.src ? (
            <div class="group relative aspect-video overflow-hidden border-b border-zinc-200 bg-zinc-950">
              <video
                class="size-full object-contain"
                controls
                preload="metadata"
                playsinline
                aria-label={`Reprodutor: ${card.title}`}
              >
                <source src={card.src} type="video/mp4" />
                Seu navegador não suporta a reprodução deste vídeo.
              </video>
              <span class="pointer-events-none absolute left-4 top-4 rounded-full bg-zinc-950/75 px-3 py-1 font-mono text-[10px] uppercase tracking-[.18em] text-blue-200 backdrop-blur">
                Vídeo {String(index + 1).padStart(2, '0')}
              </span>
            </div>
          ) : (
            <div class="flex aspect-video items-center justify-center border-b border-zinc-200 bg-zinc-950 p-6 text-center text-zinc-500">
              <div>
                <p class="font-mono text-xs uppercase tracking-[.18em] text-blue-300">
                  Vídeo {String(index + 1).padStart(2, '0')}
                </p>
                <p class="mt-3 text-sm">Espaço reservado para o próximo vídeo</p>
              </div>
            </div>
          )}
          <div class="p-6 sm:p-7">
            <h3 class="display-title text-2xl font-semibold tracking-tight text-zinc-950 sm:text-3xl">
              {card.title}
            </h3>
            <p class="mt-3 leading-7 text-zinc-600">{card.description}</p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
