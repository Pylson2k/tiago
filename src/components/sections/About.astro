---
export interface Credential {
  label: string;
  value: string;
}
export interface Props {
  eyebrow?: string;
  title: string;
  description: string;
  philosophy?: string;
  differentialsIntro?: string;
  differentials?: string[];
  differentialsConclusion?: string;
  image?: string;
  imageAlt?: string;
  credentials?: Credential[];
}
const {
  eyebrow = 'Sobre o treinador',
  title,
  description,
  philosophy,
  differentialsIntro,
  differentials = [],
  differentialsConclusion,
  image,
  imageAlt = '',
  credentials = [],
} = Astro.props;
---

<section id="sobre" class="bg-white px-5 py-[var(--space-section)] sm:px-8 lg:px-12">
  <div class="editorial-container grid gap-10 lg:grid-cols-[.82fr_1.18fr] lg:items-start lg:gap-16">
    {image && (
      <img
        src={image}
        alt={imageAlt}
        width="1536"
        height="2048"
        loading="lazy"
        class="block aspect-[4/5] w-full max-w-md rounded-[2.5rem] object-cover object-center shadow-xl shadow-zinc-900/10 lg:sticky lg:top-24"
      />
    )}
    <div>
      <p class="eyebrow">02 / {eyebrow}</p>
      <h2 class="display-title mt-5 text-4xl font-semibold leading-[.95] tracking-[-.045em] text-zinc-950 sm:text-6xl">
        {title}
      </h2>
      <article class="mt-8 max-w-2xl rounded-r-3xl rounded-l-md border border-zinc-200 border-l-4 border-l-blue-600 bg-zinc-50 p-5 sm:p-7">
        <p class="text-xs font-semibold uppercase tracking-[.18em] text-blue-600">Trajetória</p>
        <p class="mt-3 text-[0.95rem] leading-7 text-zinc-600 sm:text-base">{description}</p>
      </article>
      {philosophy && (
        <article class="mt-4 max-w-2xl rounded-3xl border border-blue-100 bg-blue-50/60 p-5 sm:p-7">
          <p class="text-xs font-semibold uppercase tracking-[.18em] text-blue-600">
            Filosofia de treinamento
          </p>
          <p class="mt-3 whitespace-pre-line text-[0.95rem] leading-7 text-zinc-600 sm:text-base">
            {philosophy}
          </p>
        </article>
      )}
      {differentials.length > 0 && (
        <article class="mt-4 max-w-2xl rounded-3xl border border-zinc-200 bg-white p-5 shadow-sm sm:p-7">
          <p class="text-xs font-semibold uppercase tracking-[.18em] text-blue-600">
            O que destaca meu trabalho
          </p>
          {differentialsIntro && (
            <p class="mt-3 text-base leading-7 text-zinc-600">{differentialsIntro}</p>
          )}
          <ul class="mt-4 grid gap-2 sm:grid-cols-2">
            {differentials.map((item) => (
              <li class="flex gap-2 rounded-xl bg-zinc-50 p-2.5 text-sm leading-5 text-zinc-600">
                <span class="mt-2 size-2 shrink-0 rounded-full bg-blue-600"></span>
                {item}
              </li>
            ))}
          </ul>
          {differentialsConclusion && (
            <p class="mt-4 text-base leading-7 text-zinc-600">{differentialsConclusion}</p>
          )}
        </article>
      )}
      {credentials.length > 0 && (
        <dl class="mt-4 grid gap-2 sm:grid-cols-2">
          {credentials.map((item) => (
            <div class="rounded-2xl border border-zinc-200 bg-zinc-50 p-4">
              <dt class="text-xs uppercase tracking-[.16em] text-zinc-500">{item.label}</dt>
              <dd class="mt-1 font-medium text-zinc-950">
                {item.value === '[A inserir]' ? 'Informação em atualização' : item.value}
              </dd>
            </div>
          ))}
        </dl>
      )}
    </div>
  </div>
</section>
