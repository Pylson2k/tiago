---
export interface Credential {
  label: string;
  value: string;
}
export interface Props {
  eyebrow?: string;
  title: string;
  description: string;
  philosophy?: string;
  differentialsIntro?: string;
  differentials?: string[];
  differentialsConclusion?: string;
  image?: string;
  imageAlt?: string;
  credentials?: Credential[];
}
const {
  eyebrow = 'Sobre o treinador',
  title,
  description,
  philosophy,
  differentialsIntro,
  differentials = [],
  differentialsConclusion,
  image,
  imageAlt = '',
  credentials = [],
} = Astro.props;
---

<section id="sobre" class="bg-white px-5 py-20 sm:px-8 lg:px-12 lg:py-28">
  <div class="mx-auto grid max-w-7xl gap-12 lg:grid-cols-[.8fr_1.2fr] lg:items-center lg:gap-24">
    {image && (
      <img
        src={image}
        alt={imageAlt}
        loading="lazy"
        class="aspect-[4/5] w-full max-w-md rounded-[2rem] object-cover"
      />
    )}
    <div>
      <p class="text-xs font-semibold uppercase tracking-[.2em] text-blue-600">{eyebrow}</p>
      <h2 class="mt-4 text-4xl font-semibold tracking-[-.045em] text-zinc-950 sm:text-5xl">
        {title}
      </h2>
      <article class="mt-8 max-w-xl rounded-3xl border border-zinc-200 bg-zinc-50 p-6 sm:p-7">
        <p class="text-xs font-semibold uppercase tracking-[.18em] text-blue-600">Trajetória</p>
        <p class="mt-4 text-base leading-8 text-zinc-600">{description}</p>
      </article>
      <div class="mt-5 grid gap-5 lg:grid-cols-2">
        {philosophy && (
          <article class="rounded-3xl border border-blue-100 bg-blue-50/60 p-6 sm:p-7">
            <p class="text-xs font-semibold uppercase tracking-[.18em] text-blue-600">
              Filosofia de treinamento
            </p>
            <p class="mt-4 whitespace-pre-line text-base leading-8 text-zinc-600">{philosophy}</p>
          </article>
        )}
        {differentials.length > 0 && (
          <article class="rounded-3xl border border-zinc-200 bg-white p-6 shadow-sm sm:p-7">
            <p class="text-xs font-semibold uppercase tracking-[.18em] text-blue-600">
              O que destaca meu trabalho
            </p>
            {differentialsIntro && (
              <p class="mt-4 text-base leading-8 text-zinc-600">{differentialsIntro}</p>
            )}
            <ul class="mt-5 grid gap-3 sm:grid-cols-2">
              {differentials.map((item) => (
                <li class="flex gap-3 rounded-2xl bg-zinc-50 p-3 text-sm leading-6 text-zinc-600">
                  <span class="mt-2 size-2 shrink-0 rounded-full bg-blue-600"></span>
                  {item}
                </li>
              ))}
            </ul>
            {differentialsConclusion && (
              <p class="mt-6 text-base leading-8 text-zinc-600">{differentialsConclusion}</p>
            )}
          </article>
        )}
      </div>
      {credentials.length > 0 && (
        <dl class="mt-5 grid gap-3 sm:grid-cols-2">
          {credentials.map((item) => (
            <div class="rounded-2xl border border-zinc-200 bg-zinc-50 p-5">
              <dt class="text-xs uppercase tracking-[.16em] text-zinc-500">{item.label}</dt>
              <dd class="mt-1 font-medium text-zinc-950">{item.value}</dd>
            </div>
          ))}
        </dl>
      )}
    </div>
  </div>
</section>
