---
export interface Credential {
  label: string;
  value: string;
}
export interface Props {
  eyebrow?: string;
  title: string;
  description: string;
  philosophy?: string;
  differentialsIntro?: string;
  differentials?: string[];
  differentialsConclusion?: string;
  image?: string;
  imageAlt?: string;
  credentials?: Credential[];
}
const {
  eyebrow = 'Sobre o treinador',
  title,
  description,
  philosophy,
  differentialsIntro,
  differentials = [],
  differentialsConclusion,
  image,
  imageAlt = '',
  credentials = [],
} = Astro.props;
---

<section id="sobre" class="bg-white px-5 py-14 sm:px-8 lg:px-12 lg:py-20">
  <div class="mx-auto grid max-w-7xl gap-8 lg:grid-cols-[.75fr_1.25fr] lg:items-start lg:gap-16">
    {image && (
      <img
        src={image}
        alt={imageAlt}
        loading="lazy"
        class="aspect-square w-full max-w-sm rounded-[2rem] object-cover"
      />
    )}
    <div>
      <p class="text-xs font-semibold uppercase tracking-[.2em] text-blue-600">{eyebrow}</p>
      <h2 class="mt-4 text-4xl font-semibold tracking-[-.045em] text-zinc-950 sm:text-5xl">
        {title}
      </h2>
      <article class="mt-6 max-w-xl rounded-3xl border border-zinc-200 bg-zinc-50 p-5 sm:p-6">
        <p class="text-xs font-semibold uppercase tracking-[.18em] text-blue-600">Trajetória</p>
        <p class="mt-3 text-base leading-7 text-zinc-600">{description}</p>
      </article>
      {philosophy && (
        <article class="mt-4 max-w-xl rounded-3xl border border-blue-100 bg-blue-50/60 p-5 sm:p-6">
          <p class="text-xs font-semibold uppercase tracking-[.18em] text-blue-600">
            Filosofia de treinamento
          </p>
          <p class="mt-3 whitespace-pre-line text-base leading-7 text-zinc-600">{philosophy}</p>
        </article>
      )}
      {differentials.length > 0 && (
        <article class="mt-4 max-w-xl rounded-3xl border border-zinc-200 bg-white p-5 shadow-sm sm:p-6">
          <p class="text-xs font-semibold uppercase tracking-[.18em] text-blue-600">
            O que destaca meu trabalho
          </p>
          {differentialsIntro && (
            <p class="mt-3 text-base leading-7 text-zinc-600">{differentialsIntro}</p>
          )}
          <ul class="mt-4 grid gap-2 sm:grid-cols-2">
            {differentials.map((item) => (
              <li class="flex gap-2 rounded-xl bg-zinc-50 p-2.5 text-sm leading-5 text-zinc-600">
                <span class="mt-2 size-2 shrink-0 rounded-full bg-blue-600"></span>
                {item}
              </li>
            ))}
          </ul>
          {differentialsConclusion && (
            <p class="mt-4 text-base leading-7 text-zinc-600">{differentialsConclusion}</p>
          )}
        </article>
      )}
      {credentials.length > 0 && (
        <dl class="mt-4 grid gap-2 sm:grid-cols-2">
          {credentials.map((item) => (
            <div class="rounded-2xl border border-zinc-200 bg-zinc-50 p-4">
              <dt class="text-xs uppercase tracking-[.16em] text-zinc-500">{item.label}</dt>
              <dd class="mt-1 font-medium text-zinc-950">{item.value}</dd>
            </div>
          ))}
        </dl>
      )}
    </div>
  </div>
</section>
