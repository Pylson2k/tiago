---
export interface Props {
  title: string;
  description: string;
  instagram?: string;
  whatsappHref?: string;
}
const { title, description, instagram, whatsappHref } = Astro.props;
---

<section id="contato" class="bg-zinc-950 px-5 py-20 text-white sm:px-8 lg:px-12 lg:py-28">
  <div class="mx-auto grid max-w-7xl gap-10 lg:grid-cols-[.8fr_1.2fr] lg:items-start lg:gap-20">
    <div>
      <p class="text-xs font-semibold uppercase tracking-[.2em] text-blue-100">Informações</p>
      <h2 class="mt-4 max-w-2xl text-4xl font-semibold tracking-[-.05em] sm:text-6xl">{title}</h2>
      <p class="mt-6 max-w-xl text-lg leading-8 text-zinc-300">{description}</p>
      <div class="mt-8 grid gap-3 sm:grid-cols-2 lg:grid-cols-1">
        {instagram && (
          <a
            href={instagram}
            target="_blank"
            rel="noopener noreferrer"
            class="group rounded-2xl border border-white/15 bg-white/5 p-4 transition hover:bg-white/10"
          >
            <span class="flex items-center gap-3">
              <img
                src="/assets/icons/instagram.svg"
                alt=""
                aria-hidden="true"
                class="size-6 brightness-0 invert"
              />
              <span>
                <span class="block text-xs uppercase tracking-[.16em] text-zinc-400">
                  Instagram
                </span>
                <span class="mt-1 block font-medium">Acompanhe os conteúdos e estudos ↗</span>
              </span>
            </span>
          </a>
        )}
        {whatsappHref && (
          <a
            href={whatsappHref}
            target="_blank"
            rel="noopener noreferrer"
            class="group rounded-2xl border border-white/15 bg-white/5 p-4 transition hover:bg-white/10"
          >
            <span class="flex items-center gap-3">
              <img
                src="/assets/icons/whatsapp.svg"
                alt=""
                aria-hidden="true"
                class="size-6 brightness-0 invert"
              />
              <span>
                <span class="block text-xs uppercase tracking-[.16em] text-zinc-400">WhatsApp</span>
                <span class="mt-1 block font-medium">Entre em contato diretamente ↗</span>
              </span>
            </span>
          </a>
        )}
      </div>
    </div>
    <form data-contact-form class="rounded-3xl bg-white p-6 text-zinc-950 shadow-xl sm:p-8">
      <h3 class="text-2xl font-semibold tracking-tight">Envie uma mensagem</h3>
      <p class="mt-2 text-sm leading-6 text-zinc-600">
        Preencha os campos. Ao enviar, sua mensagem será organizada e encaminhada ao WhatsApp.
      </p>
      <div class="mt-6 grid gap-4 sm:grid-cols-2">
        <label class="text-sm font-medium">
          Nome
          <input
            required
            name="nome"
            autocomplete="name"
            class="mt-2 min-h-11 w-full rounded-xl border border-zinc-300 px-3 outline-none focus:border-blue-600 focus:ring-2 focus:ring-blue-100"
          />
        </label>
        <label class="text-sm font-medium">
          E-mail
          <input
            required
            type="email"
            name="email"
            autocomplete="email"
            class="mt-2 min-h-11 w-full rounded-xl border border-zinc-300 px-3 outline-none focus:border-blue-600 focus:ring-2 focus:ring-blue-100"
          />
        </label>
        <label class="text-sm font-medium">
          Telefone
          <input
            required
            name="telefone"
            type="tel"
            autocomplete="tel"
            class="mt-2 min-h-11 w-full rounded-xl border border-zinc-300 px-3 outline-none focus:border-blue-600 focus:ring-2 focus:ring-blue-100"
          />
        </label>
      </div>
      <label class="mt-4 block text-sm font-medium">
        Assunto
        <select
          required
          name="assunto"
          class="mt-2 min-h-11 w-full rounded-xl border border-zinc-300 bg-white px-3 outline-none focus:border-blue-600 focus:ring-2 focus:ring-blue-100"
        >
          <option value="">Selecione uma opção</option>
          <option>Treinamento presencial</option>
          <option>Consultoria online</option>
          <option>Informação acadêmica</option>
          <option>Outro assunto</option>
        </select>
      </label>
      <label class="mt-4 block text-sm font-medium">
        Mensagem
        <textarea
          required
          name="mensagem"
          rows="4"
          class="mt-2 w-full resize-y rounded-xl border border-zinc-300 px-3 py-3 outline-none focus:border-blue-600 focus:ring-2 focus:ring-blue-100"
        ></textarea>
      </label>
      <button
        type="submit"
        class="mt-5 inline-flex min-h-12 w-full items-center justify-center rounded-xl bg-zinc-950 px-5 text-sm font-semibold text-white transition hover:bg-zinc-800 focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-600"
      >
        Enviar pelo WhatsApp
      </button>
      <p data-contact-status class="mt-3 hidden text-sm text-zinc-600" role="status"></p>
    </form>
  </div>
</section>

<script is:inline>
  document.querySelectorAll('[data-contact-form]').forEach((form) => {
    form.addEventListener('submit', (event) => {
      event.preventDefault();
      const data = new FormData(form);
      const message = `Olá, Tiago! Meu nome é ${data.get('nome')}.\nTelefone: ${data.get('telefone')}\nE-mail: ${data.get('email')}\nAssunto: ${data.get('assunto')}\n\n${data.get('mensagem')}`;
      const url = `https://wa.me/5511963552470?text=${encodeURIComponent(message)}`;
      const status = form.querySelector('[data-contact-status]');
      if (status) {
        status.textContent = 'Abrindo o WhatsApp com sua mensagem…';
        status.classList.remove('hidden');
      }
      window.open(url, '_blank', 'noopener,noreferrer');
    });
  });
</script>
