---
import { Instagram, Mail } from 'lucide-astro';

export interface Props {
  title: string;
  description: string;
  email?: string;
  instagram?: string;
}
const { title, description, email, instagram } = Astro.props;
---

<section id="contato" class="bg-blue-600 px-5 py-20 text-white sm:px-8 lg:px-12 lg:py-28">
  <div class="mx-auto grid max-w-7xl gap-10 lg:grid-cols-[1fr_auto] lg:items-end">
    <div>
      <p class="text-xs font-semibold uppercase tracking-[.2em] text-blue-100">Informações</p>
      <h2 class="mt-4 max-w-2xl text-4xl font-semibold tracking-[-.05em] sm:text-6xl">{title}</h2>
      <p class="mt-6 max-w-xl text-lg leading-8 text-blue-100">{description}</p>
    </div>
    <div class="flex flex-col items-start gap-5 lg:items-end">
      <div class="flex flex-wrap gap-4 text-sm text-blue-100">
        {email && (
          <a
            href={`mailto:${email}`}
            class="inline-flex min-h-11 items-center gap-2 underline underline-offset-4"
          >
            <Mail size={16} aria-hidden="true" />
            {email}
          </a>
        )}
        {instagram && (
          <a
            href={instagram}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex min-h-11 items-center gap-2 underline underline-offset-4"
          >
            <Instagram size={16} aria-hidden="true" />
            Ver conteúdo no Instagram
          </a>
        )}
      </div>
    </div>
  </div>
</section>
