  {
    src: '/assets/provas/depoimento-ana.jpg',
    alt: 'Print de depoimento de aluna',
    label: 'Depoimento de aluna',
    authorization: 'Publicado com autorização.',
  },
  {
    src: '/assets/provas/depoimento-ana-couto.jpeg',
    alt: 'Print de depoimento de aluna sobre oito meses de acompanhamento',
    label: 'Depoimento de aluna',
    authorization: 'Publicado com autorização.',
  },
  {
    src: '/assets/provas/depoimento-ana-vitoria.jpeg',
    alt: 'Print de depoimento de aluna sobre evolução corporal',
    label: 'Depoimento de aluna',
    authorization: 'Publicado com autorização.',
  },
  {
    src: '/assets/provas/depoimento-beatriz.jpeg',
