    title: 'Conhecer',
    description: '[Texto a inserir: etapa conhecer.]',
  },
  {
    number: '02',
    title: 'Planejar',
    description: '[Texto a inserir: etapa planejar.]',
  },
  {
    number: '03',
    title: 'Acompanhar',
    description: '[Texto a inserir: etapa acompanhar.]',
  },
  {
