    description: '[Texto a inserir: etapa acompanhar.]',
  },
  {
    number: '04',
    title: 'Ajustar',
    description: '[Texto a inserir: etapa ajustar.]',
  },
];

const contentItems = [
  {
    type: 'Biomecânica',
    title: 'Como pensar a execução antes de aumentar a carga',
    description: '[Texto a inserir: artigo ou post sobre biomecânica.]',
    href: '#biomecanica',
  },
  {
    type: 'Treino',
    title: 'Progressão não é apenas colocar mais peso',
    description: '[Texto a inserir: conteúdo educativo sobre treinamento.]',
    href: '#treino-da-semana',
  },
  {
    type: 'Rotina',
    title: 'Um treino que cabe na vida tem mais chance de continuar',
    description: '[Texto a inserir: conteúdo complementar.]',
  },
