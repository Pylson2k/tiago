    label: 'Depoimento de aluna',
    authorization: 'Publicado com autorização.',
  },
  {
    src: '/assets/provas/depoimento-cassia.jpg',
    alt: 'Print de depoimento de aluna sobre resultados',
    label: 'Depoimento de aluna',
