    description: '[Texto a inserir: se o Tiago oferece consultoria online e como funciona.]',
    detail: 'Online',
    modal: {
      title: 'Consultoria online',
      description: '[Texto a inserir: descrição detalhada da consultoria online.]',
      points: [
        'Treino organizado para sua rotina',
        'Canal de acompanhamento e feedback',
        'Revisões periódicas do plano',
      ],
    },
  },
  {
    title: 'Planejamento personalizado',
    description: '[Texto a inserir: trabalho voltado para hipertrofia e emagrecimento.]',
    detail: 'Sob medida',
    modal: {
      title: 'Planejamento personalizado',
      description: '[Texto a inserir: abordagem para hipertrofia e emagrecimento.]',
      points: [
