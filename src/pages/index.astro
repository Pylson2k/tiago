---
import BaseLayout from '../layouts/BaseLayout.astro';
import BrandMark from '../components/BrandMark.astro';
import Hero from '../components/sections/Hero.astro';
import TrustBar from '../components/sections/TrustBar.astro';
import ResultCaseGabriel from '../components/sections/ResultCaseGabriel.astro';
import SocialProof from '../components/sections/SocialProof.astro';
import VideoContent from '../components/sections/VideoContent.astro';
import TrainingExperience from '../components/sections/TrainingExperience.astro';
import Services from '../components/sections/Services.astro';
import Method from '../components/sections/Method.astro';
