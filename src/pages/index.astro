---
import BaseLayout from '../layouts/BaseLayout.astro';
import BrandMark from '../components/BrandMark.astro';
import Hero from '../components/sections/Hero.astro';
import TrustBar from '../components/sections/TrustBar.astro';
import ResultCaseGabriel from '../components/sections/ResultCaseGabriel.astro';
import SocialProof from '../components/sections/SocialProof.astro';
import VideoContent from '../components/sections/VideoContent.astro';
import TrainingExperience from '../components/sections/TrainingExperience.astro';
import Services from '../components/sections/Services.astro';
import Method from '../components/sections/Method.astro';
import About from '../components/sections/About.astro';
import ContentPreview from '../components/sections/ContentPreview.astro';
import Contact from '../components/sections/Contact.astro';
import { Menu, MessageCircle } from 'lucide-astro';

const whatsappHref =
  'https://wa.me/5511963552470?text=Ol%C3%A1%20Tiago%2C%20vim%20pelo%20seu%20portf%C3%B3lio%20e%20quero%20conhecer%20o%20acompanhamento.';

const services = [
  {
    title: 'Treinamento presencial',
    description:
      'Sessões orientadas de perto, com atenção à execução, ao ritmo e ao objetivo de cada aluno.',
    detail: 'Presencial',
    modal: {
      title: 'Treinamento presencial',
      description:
        'Sessões orientadas de perto para transformar cada treino em uma prática clara e segura.',
      points: [
        'Observação da execução em tempo real',
        'Ajustes de carga, amplitude e ritmo',
        'Planejamento alinhado ao objetivo e à rotina',
      ],
    },
  },
  {
    title: 'Consultoria online',
    description:
      'Planejamento remoto com acompanhamento e ajustes baseados nos retornos do processo.',
    detail: 'Online',
    modal: {
      title: 'Consultoria online',
      description:
        'Acompanhamento remoto com planejamento, retornos e ajustes ao longo do processo.',
      points: [
        'Treino organizado para sua rotina',
        'Canal de acompanhamento e feedback',
        'Revisões periódicas do plano',
      ],
    },
  },
  {
    title: 'Planejamento personalizado',
    description:
      'Estrutura individual para hipertrofia, emagrecimento, condicionamento e performance, respeitando experiência e rotina.',
    detail: 'Sob medida',
    modal: {
      title: 'Planejamento personalizado',
      description:
        'Uma estrutura individual para hipertrofia, emagrecimento, condicionamento ou performance.',
      points: [
        'Escolha de exercícios com intenção',
        'Progressão de volume e estímulos',
        'Adaptações conforme sua resposta',
      ],
    },
  },
  {
    title: 'Avaliação e acompanhamento',
    description:
      'Observação do movimento, orientação de execução e ajustes periódicos conforme a evolução.',
    detail: 'Acompanhamento',
    modal: {
      title: 'Avaliação e acompanhamento',
      description:
        'Leitura do movimento e do processo para que o treinamento continue fazendo sentido.',
      points: [
        'Avaliação do momento atual',
        'Orientação de execução',
        'Ajustes periódicos baseados na evolução',
      ],
    },
  },
];

const steps = [
  {
    number: '01',
    title: 'Conhecer',
    description:
      'Entender objetivo, rotina, experiência e contexto antes de escolher qualquer estímulo.',
  },
  {
    number: '02',
    title: 'Planejar',
    description: 'Organizar exercícios, volume e progressão de acordo com o momento do aluno.',
  },
  {
    number: '03',
    title: 'Acompanhar',
    description: 'Observar execução, adesão e percepção para transformar o plano em prática.',
  },
  {
    number: '04',
    title: 'Ajustar',
    description: 'Revisar o caminho com consistência, sem depender de fórmulas prontas.',
  },
];

const contentItems = [
  {
    type: 'Biomecânica',
    title: 'Como pensar a execução antes de aumentar a carga',
    description:
      'Um guia direto para observar posição, trajetória e intenção em exercícios básicos.',
    href: '#biomecanica',
  },
  {
    type: 'Treino',
    title: 'Progressão não é apenas colocar mais peso',
    description: 'Volume, controle, amplitude e consistência também fazem parte da evolução.',
    href: '#treino-da-semana',
  },
  {
    type: 'Rotina',
    title: 'Um treino que cabe na vida tem mais chance de continuar',
    description:
      'A melhor estratégia é aquela que o aluno consegue aplicar com clareza e regularidade.',
  },
];

const socialCases = [
  {
    title: 'Evolução de composição corporal',
    image: {
      src: '/assets/provas/antes-depois-01.jpeg',
      alt: 'Comparativo antes e depois da evolução de composição corporal da aluna',
    },
    authorization: 'Imagem publicada mediante autorização da aluna.',
  },
  {
    title: 'Evolução de treinamento',
    image: {
      src: '/assets/provas/antes-depois-02.jpeg',
      alt: 'Comparativo antes e depois da evolução de treinamento da aluna',
    },
    authorization: 'Imagem publicada mediante autorização da aluna.',
  },
];

const testimonialImages = [
  {
    src: '/assets/provas/depoimento-ana.jpg',
    alt: 'Print de depoimento de aluna',
    label: 'Depoimento de aluna',
    authorization: 'Publicado com autorização.',
  },
  {
    src: '/assets/provas/depoimento-ana-couto.jpeg',
    alt: 'Print de depoimento de aluna sobre oito meses de acompanhamento',
    label: 'Depoimento de aluna',
    authorization: 'Publicado com autorização.',
  },
  {
    src: '/assets/provas/depoimento-ana-vitoria.jpeg',
    alt: 'Print de depoimento de aluna sobre evolução corporal',
    label: 'Depoimento de aluna',
    authorization: 'Publicado com autorização.',
  },
  {
    src: '/assets/provas/depoimento-beatriz.jpeg',
    alt: 'Print de depoimento de aluna',
    label: 'Depoimento de aluna',
    authorization: 'Publicado com autorização.',
  },
  {
    src: '/assets/provas/depoimento-cassia.jpg',
    alt: 'Print de depoimento de aluna sobre resultados',
    label: 'Depoimento de aluna',
    authorization: 'Publicado com autorização.',
  },
  {
    src: '/assets/provas/depoimento-cassia-full.jpeg',
    alt: 'Print de depoimento de aluna',
    label: 'Depoimento de aluna',
    authorization: 'Publicado com autorização.',
  },
  {
    src: '/assets/provas/depoimento-lary.png',
    alt: 'Print de depoimento de aluna sobre perda de peso',
    label: 'Depoimento de aluna',
    authorization: 'Publicado com autorização.',
  },
  {
    src: '/assets/provas/depoimento-yara.jpeg',
    alt: 'Print de depoimento de aluna',
    label: 'Depoimento de aluna',
    authorization: 'Publicado com autorização.',
  },
];
---

<BaseLayout
  title="Tiago Filadelfo — Treinamento individualizado"
  description="Treinamento individualizado para hipertrofia, recomposição corporal e condicionamento, com acompanhamento próximo."
  canonical="https://tiago-liart.vercel.app/"
>
  <header
    class="absolute inset-x-0 top-0 z-20 border-b border-white/10 bg-zinc-950/70 text-white backdrop-blur"
    id="topo"
  >
    <div class="mx-auto flex max-w-7xl items-center justify-between gap-3 px-5 py-5 sm:px-8 lg:px-12">
      <BrandMark />
      <nav
        class="hidden items-center gap-7 text-sm text-zinc-300 lg:flex"
        aria-label="Navegação principal"
      >
        <a class="transition hover:text-white" href="#metodo">
          Método
        </a>
        <a class="transition hover:text-white" href="#resultados">
          Resultados
        </a>
        <a class="transition hover:text-white" href="#treino-da-semana">
          Treino da semana
        </a>
        <a class="transition hover:text-white" href="#servicos">
          Serviços
        </a>
        <a class="transition hover:text-white" href="#sobre">
          Sobre
        </a>
      </nav>
      <div class="flex shrink-0 items-center gap-2">
        <a
          class="hidden min-h-11 items-center rounded-full bg-blue-600 px-5 text-xs font-semibold text-white transition hover:bg-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-300 sm:inline-flex"
          href={whatsappHref}
        >
          Falar no WhatsApp
        </a>
        <details class="group relative lg:hidden">
          <summary
            class="flex size-11 cursor-pointer list-none items-center justify-center rounded-full border border-white/15 bg-white/5 text-white transition hover:bg-white/10 focus:outline-none focus:ring-2 focus:ring-blue-300 [&::-webkit-details-marker]:hidden"
            aria-label="Abrir menu de navegação"
          >
            <Menu size={20} aria-hidden="true" />
          </summary>
          <nav
            class="absolute right-0 top-14 z-40 grid w-64 overflow-hidden rounded-2xl border border-white/10 bg-zinc-950 p-2 text-sm text-zinc-200 shadow-2xl"
            aria-label="Navegação móvel"
          >
            <a class="rounded-xl px-4 py-3 hover:bg-white/10" href="#metodo">
              Método
            </a>
            <a class="rounded-xl px-4 py-3 hover:bg-white/10" href="#resultados">
              Resultados
            </a>
            <a class="rounded-xl px-4 py-3 hover:bg-white/10" href="#treino-da-semana">
              Treino da semana
            </a>
            <a class="rounded-xl px-4 py-3 hover:bg-white/10" href="#servicos">
              Serviços
            </a>
            <a class="rounded-xl px-4 py-3 hover:bg-white/10" href="#sobre">
              Sobre
            </a>
            <a
              class="mt-1 rounded-xl bg-blue-600 px-4 py-3 font-semibold text-white"
              href={whatsappHref}
            >
              Falar no WhatsApp
            </a>
          </nav>
        </details>
      </div>
    </div>
  </header>

  <main id="conteudo-principal" tabindex="-1">
    <Hero
      eyebrow="Tiago Filadelfo · Treinador · Hipertrofia & Condicionamento"
      title="Treino inteligente. Evolução que você consegue sustentar."
      description="Planejamento individualizado para hipertrofia, recomposição corporal e condicionamento, com acompanhamento próximo e execução bem orientada."
      image="/assets/tiago-training.webp"
      imageAlt="Tiago orientando um treino em ambiente profissional"
      primaryHref={whatsappHref}
      primaryLabel="Agendar conversa"
      secondaryHref="#resultados"
      secondaryLabel="Ver resultados"
    />
    <TrustBar
      items={[
        { label: 'Formato', value: 'Presencial e online' },
        { label: 'Abordagem', value: 'Planejamento individual' },
        { label: 'Foco', value: 'Execução e consistência' },
        { label: 'Próximo passo', value: 'Conversa no WhatsApp' },
      ]}
    />
    <ResultCaseGabriel
      title="Gabriel: mais volume e desenvolvimento global"
      summary="Um processo construído com treinamento estruturado, consistência e acompanhamento ao longo do tempo. A evolução apresentada nas imagens é visual e não substitui uma avaliação física."
      image="/assets/gabriel-evolucao.jpeg"
      imageAlt="Montagem com registros de Gabriel antes e depois em pose de duplo bíceps frontal"
      highlights={[
        'Objetivo: hipertrofia',
        'Planejamento individualizado',
        'Progressão de cargas e estímulos',
        'Ajustes periódicos no treinamento',
      ]}
    />
    <SocialProof
      title="Quem treinou, conta"
      intro="Casos, relatos e momentos reais do trabalho desenvolvido."
      cases={socialCases}
      testimonials={testimonialImages}
      disclaimer="Resultados variam conforme histórico, rotina, adesão e individualidade de cada pessoa. Publicações de imagens e depoimentos dependem de autorização."
    />
    <VideoContent
      title="Conteúdo técnico em movimento"
      intro="Dois espaços para apresentar, com clareza, a abordagem de trabalho e o conhecimento aplicado aos esportes coletivos."
      cards={[
        {
          title: 'Apresentação do trabalho',
          description: 'Card reservado para um novo vídeo de apresentação do acompanhamento.',
        },
        {
          title: 'Esportes coletivos',
          description: 'Card reservado para um novo vídeo sobre a matéria de esportes coletivos.',
        },
      ]}
    />
    <TrainingExperience whatsappHref={whatsappHref} />
    <Services
      title="Um plano que conversa com o seu momento"
      intro="Escolha o formato de acompanhamento que faz sentido para a sua rotina e converse para entender os próximos passos."
      services={services}
    />
    <Method
      title="Método simples de entender. Difícil de fingir."
      intro="O trabalho começa antes do primeiro exercício e continua depois da sessão: observar, decidir, acompanhar e ajustar."
      steps={steps}
    />
    <About
      title="Da vivência no esporte ao acompanhamento individual"
      description="Tiago Filadelfo é graduando em Educação Física e treinador. Sua trajetória une prática esportiva, estudo contínuo e acompanhamento próximo. A filosofia de trabalho parte da biomecânica, da execução consciente e de ajustes que respeitam o contexto de cada aluno — sem atalhos ou fórmulas prontas."
      image="/assets/tiago-portrait.webp"
      imageAlt="Retrato profissional de Tiago Filadelfo"
      credentials={[
        { label: 'Formação', value: 'Bacharelado em Educação Física — em andamento' },
        { label: 'Estudo contínuo', value: 'Biomecânica e análise do movimento' },
        { label: 'Filosofia', value: 'Consistência antes de promessa' },
        { label: 'Diferencial', value: 'Planejamento, didática e ajustes individuais' },
      ]}
    />
    <ContentPreview
      title="Conhecimento que vira prática"
      intro="Conteúdo técnico para treinar com mais intenção e menos ruído."
      items={contentItems}
    />
    <Contact
      title="Vamos entender o que você precisa para evoluir?"
      description="Envie uma mensagem e conte seu objetivo. A primeira conversa serve para entender seu momento e apresentar o formato de acompanhamento mais adequado."
      whatsappHref={whatsappHref}
      whatsappLabel="Agendar avaliação online"
      instagram="https://www.instagram.com/reel/DIy91aMOAVY/?igsh=YmJja3lrOHRsOW4y"
    />
  </main>

  <footer class="bg-zinc-950 px-5 pb-[calc(6rem+env(safe-area-inset-bottom))] pt-8 text-sm text-zinc-500 sm:px-8 sm:py-8 lg:px-12">
    <div class="mx-auto flex max-w-7xl flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
      <span>© {new Date().getFullYear()} Tiago Filadelfo</span>
      <a class="inline-flex min-h-11 items-center transition hover:text-white" href="#topo">
        Voltar ao topo ↑
      </a>
    </div>
  </footer>

  <a
    href={whatsappHref}
    class="fixed bottom-[calc(1rem+env(safe-area-inset-bottom))] right-4 z-50 inline-flex min-h-12 items-center justify-center gap-2 rounded-full bg-blue-600 px-4 text-sm font-semibold text-white shadow-2xl shadow-blue-950/35 transition hover:bg-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-300 max-[359px]:size-12 max-[359px]:px-0 sm:right-6 sm:min-h-14 sm:px-6"
    aria-label="Quero treinar com Tiago pelo WhatsApp"
  >
    <MessageCircle size={19} aria-hidden="true" />
    <span class="max-[359px]:hidden sm:hidden">Quero treinar</span>
    <span class="hidden sm:inline">Quero treinar com você</span>
  </a>

  <script is:inline>
    document.querySelectorAll('header details nav a').forEach((link) => {
      link.addEventListener('click', () => link.closest('details')?.removeAttribute('open'));
    });
  </script>
</BaseLayout>
