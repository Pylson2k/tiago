---

<BaseLayout
  title="Tiago Filadelfo — Treinamento individualizado"
  description="Treinamento individualizado para hipertrofia, recomposição corporal e condicionamento, com acompanhamento próximo."
  canonical="https://tiago-liart.vercel.app/"
>
  <header
    class="absolute inset-x-0 top-0 z-20 border-b border-white/10 bg-zinc-950/70 text-white backdrop-blur"
    id="topo"
  >
    <div class="mx-auto flex max-w-7xl items-center justify-between gap-3 px-5 py-5 sm:px-8 lg:px-12">
      <BrandMark />
      <nav
        class="hidden items-center gap-7 text-sm text-zinc-300 lg:flex"
        aria-label="Navegação principal"
      >
        <a class="transition hover:text-white" href="#metodo">
          Método
        </a>
        <a class="transition hover:text-white" href="#resultados">
          Resultados
        </a>
        <a class="transition hover:text-white" href="#treino-da-semana">
          Treino da semana
        </a>
        <a class="transition hover:text-white" href="#servicos">
          Serviços
        </a>
        <a class="transition hover:text-white" href="#sobre">
          Sobre
        </a>
      </nav>
      <div class="flex shrink-0 items-center gap-2">
        <details class="group relative lg:hidden">
          <summary
            class="flex size-11 cursor-pointer list-none items-center justify-center rounded-full border border-white/15 bg-white/5 text-white transition hover:bg-white/10 focus:outline-none focus:ring-2 focus:ring-blue-300 [&::-webkit-details-marker]:hidden"
            aria-label="Abrir menu de navegação"
          >
            <Menu size={20} aria-hidden="true" />
          </summary>
          <nav
            class="absolute right-0 top-14 z-40 grid w-64 overflow-hidden rounded-2xl border border-white/10 bg-zinc-950 p-2 text-sm text-zinc-200 shadow-2xl"
            aria-label="Navegação móvel"
          >
            <a class="rounded-xl px-4 py-3 hover:bg-white/10" href="#metodo">
              Método
            </a>
            <a class="rounded-xl px-4 py-3 hover:bg-white/10" href="#resultados">
              Resultados
            </a>
            <a class="rounded-xl px-4 py-3 hover:bg-white/10" href="#treino-da-semana">
              Treino da semana
            </a>
            <a class="rounded-xl px-4 py-3 hover:bg-white/10" href="#servicos">
              Serviços
            </a>
            <a class="rounded-xl px-4 py-3 hover:bg-white/10" href="#sobre">
              Sobre
            </a>
          </nav>
        </details>
      </div>
    </div>
  </header>

  <main id="conteudo-principal" tabindex="-1">
    <Hero
      eyebrow="Portfólio acadêmico · Educação Física"
      title="Tiago Filadelfo: treinamento, estudo e prática profissional"
      description="Este portfólio reúne a trajetória, a formação, a filosofia de treino e registros da atuação de Tiago no campo do treinamento físico."
      image="/assets/tiago-training.webp"
      imageAlt="Tiago orientando um treino em ambiente profissional"
      secondaryHref="#resultados"
      secondaryLabel="Consultar registros"
    />
    <TrustBar
      items={[
        { label: 'Formato', value: 'Presencial e online' },
        { label: 'Abordagem', value: 'Planejamento individual' },
        { label: 'Foco', value: 'Execução e consistência' },
        { label: 'Registro', value: 'Portfólio acadêmico' },
      ]}
    />
    <ResultCaseGabriel
      title="Gabriel: mais volume e desenvolvimento global"
      summary="Um processo construído com treinamento estruturado, consistência e acompanhamento ao longo do tempo. A evolução apresentada nas imagens é visual e não substitui uma avaliação física."
      image="/assets/gabriel-evolucao.jpeg"
      imageAlt="Montagem com registros de Gabriel antes e depois em pose de duplo bíceps frontal"
      highlights={[
        'Objetivo: hipertrofia',
        'Planejamento individualizado',
        'Progressão de cargas e estímulos',
        'Ajustes periódicos no treinamento',
      ]}
    />
    <SocialProof
      title="Quem treinou, conta"
      intro="Casos, relatos e momentos reais do trabalho desenvolvido."
      cases={socialCases}
      testimonials={testimonialImages}
      disclaimer="Resultados variam conforme histórico, rotina, adesão e individualidade de cada pessoa. Publicações de imagens e depoimentos dependem de autorização."
    />
    <VideoContent
      title="Conteúdo técnico em movimento"
      intro="Dois espaços para apresentar, com clareza, a abordagem de trabalho e o conhecimento aplicado aos esportes coletivos."
      cards={[
        {
          title: 'Apresentação do trabalho',
          description: 'Card reservado para um novo vídeo de apresentação do acompanhamento.',
        },
        {
          title: 'Esportes coletivos',
          description: 'Card reservado para um novo vídeo sobre a matéria de esportes coletivos.',
        },
      ]}
    />
    <TrainingExperience />
    <Services
      title="Programas e formatos de treinamento"
      intro="[Texto a inserir: descrição dos treinamentos presenciais, consultorias online e formas de acompanhamento.]"
      services={services}
    />
    <Method
      title="Metodologia de trabalho"
      intro="[Texto a inserir: como o Tiago estrutura, acompanha e ajusta o treinamento.]"
      steps={steps}
    />
    <About
      title="Trajetória e formação profissional"
      description="[Texto a inserir: trajetória do Tiago no fitness, formação acadêmica, cursos, especializações, certificações, filosofia de treino e diferenciais profissionais.]"
      image="/assets/tiago-portrait.webp"
      imageAlt="Retrato profissional de Tiago Filadelfo"
      credentials={[
        { label: 'Formação acadêmica', value: '[A inserir]' },
        { label: 'Cursos e especializações', value: '[A inserir]' },
        { label: 'Filosofia de treino', value: '[A inserir]' },
        { label: 'Diferenciais profissionais', value: '[A inserir]' },
      ]}
    />
    <ContentPreview
      title="Produção acadêmica e conteúdo técnico"
      intro="[Texto a inserir: artigo ou post sobre biomecânica e análise do movimento.]"
      items={contentItems}
    />
    <Contact
      title="Referências e informações complementares"
      description="[Texto a inserir: contatos acadêmicos, referências, links de artigos, redes profissionais ou materiais complementares.]"
    />
  </main>

  <footer class="bg-zinc-950 px-5 pb-[calc(6rem+env(safe-area-inset-bottom))] pt-8 text-sm text-zinc-500 sm:px-8 sm:py-8 lg:px-12">
    <div class="mx-auto flex max-w-7xl flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
      <span>© {new Date().getFullYear()} Tiago Filadelfo</span>
      <a class="inline-flex min-h-11 items-center transition hover:text-white" href="#topo">
        Voltar ao topo ↑
      </a>
    </div>
  </footer>

  <script is:inline>
    document.querySelectorAll('header details nav a').forEach((link) => {
      link.addEventListener('click', () => link.closest('details')?.removeAttribute('open'));
    });
  </script>
</BaseLayout>
