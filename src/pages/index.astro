        'Progressão de volume e estímulos',
        'Adaptações conforme sua resposta',
      ],
    },
  },
  {
    title: 'Avaliação e acompanhamento',
    description: '[Texto a inserir: avaliação, acompanhamento e critérios de ajuste.]',
    detail: 'Acompanhamento',
    modal: {
      title: 'Avaliação e acompanhamento',
      description: '[Texto a inserir: como são feitas a avaliação e o acompanhamento.]',
      points: [
        'Avaliação do momento atual',
        'Orientação de execução',
        'Ajustes periódicos baseados na evolução',
      ],
    },
  },
];

const steps = [
  {
    number: '01',
    title: 'Conhecer',
    description: '[Texto a inserir: etapa conhecer.]',
  },
  {
    number: '02',
